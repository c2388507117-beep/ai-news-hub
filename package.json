{
  "name": "ai-news-hub",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npx pagefind --site dist",
    "preview": "npm run build && wrangler dev",
    "fetch:news": "node scripts/fetch-news.mjs",
    "fetch:trending": "node scripts/fetch-trending.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "12",
    "@astrojs/tailwind": "^6.0.0",
    "astro": "^5.0.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@octokit/rest": "^21.0.0",
    "pagefind": "^1.3.0",
    "rss-parser": "^3.13.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.94.0"
  }
}
