---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wallpaper from '../components/Wallpaper.astro';
import NetEaseMusic from '../components/NetEaseMusic.astro';
import StockMarket from '../components/StockMarket.astro';
import WallpaperGallery from '../components/WallpaperGallery.astro';
import DailyKnowledge from '../components/DailyKnowledge.astro';
import TodayHistory from '../components/TodayHistory.astro';
import DailyDigest from '../components/DailyDigest.astro';
import SalaryCountdown from '../components/SalaryCountdown.astro';
import CurrencyExchange from '../components/CurrencyExchange.astro';
import DutyRoster from '../components/DutyRoster.astro';
import WorldMap from '../components/WorldMap.astro';
import XingtaiWeather from '../components/XingtaiWeather.astro';
import GameDealCard from '../components/GameDealCard.astro';
import NationalStandards from '../components/NationalStandards.astro';
import Footer from '../components/Footer.astro';
import type { WallpaperData, KnowledgeList, DigestData, TodayHistoryData } from '../lib/types';
import wallpaperData from '../data/wallpapers.json';
import wallpaperGirlData from '../data/wallpapers-girl.json';
import knowledgeData from '../data/knowledge.json';
import digestData from '../data/digest.json';
import todayHistoryData from '../data/today-history.json';
import nationalStandardsData from '../data/national-standards.json';
import gameDealsData from '../data/game-deals.json';

const wallpapers = wallpaperData as WallpaperData;
const wallpapersGirl = wallpaperGirlData as WallpaperData;
const knowledge = knowledgeData as KnowledgeList | null;
const digest = digestData as DigestData;
const todayHistory = todayHistoryData as TodayHistoryData;
const nationalStandards = nationalStandardsData as any;
const gameDeals = gameDealsData as any;

const ogTitle = 'AI News Hub - 个人仪表盘';
const ogDescription = '游戏打折资讯、全球股指、每日文摘、国标学习';
const ogImage = undefined;
---

<BaseLayout
  title="AI News Hub - 个人仪表盘"
  {ogTitle}
  {ogDescription}
  {ogImage}
>
  <Wallpaper data={wallpapers} />

  <main class="max-w-6xl mx-auto px-4 py-6 space-y-5">
    <!-- ═══ 1. 快捷信息栏 ═══ -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <XingtaiWeather />
      <DailyDigest data={digest} />
      <SalaryCountdown />
    </div>

    <!-- ═══ 2. 行情 ═══ -->
    <StockMarket />

    <!-- ═══ 3. Steam 打折资讯 ═══ -->
    <section>
      <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 overflow-hidden shadow-sm">
        <div class="bg-gradient-to-r from-green-600 to-emerald-600 px-4 py-2.5 text-sm font-bold text-white flex items-center gap-2">
          <span aria-hidden="true">🎮</span> Steam 游戏打折（国区 ¥）
        </div>
        <div class="p-4">
          <GameDealCard items={gameDeals.items || []} />
        </div>
      </div>
    </section>

    <!-- ═══ 4. 知识 & 学习 (2列) ═══ -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      <div class="space-y-4">
        <DailyKnowledge data={knowledge} />
        <TodayHistory data={todayHistory} />
      </div>
      <div class="space-y-4">
        <NationalStandards items={nationalStandards.items || []} />
        <DutyRoster />
      </div>
    </div>

    <!-- ═══ 5. 娱乐 & 工具 ═══ -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
      <NetEaseMusic />
      <WallpaperGallery data={wallpapersGirl} title="美女壁纸" emoji="💃" />
      <CurrencyExchange />
    </div>

    <WorldMap />
  </main>
  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>
