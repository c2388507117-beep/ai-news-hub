---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import Wallpaper from '../components/Wallpaper.astro';
import NetEaseMusic from '../components/NetEaseMusic.astro';
import FootballStandings from '../components/FootballStandings.astro';
import SteamCharts from '../components/SteamCharts.astro';
import BilibiliFavorites from '../components/BilibiliFavorites.astro';
import StockMarket from '../components/StockMarket.astro';
import WallpaperGallery from '../components/WallpaperGallery.astro';
import DailyKnowledge from '../components/DailyKnowledge.astro';
import DailyDigest from '../components/DailyDigest.astro';
import SalaryCountdown from '../components/SalaryCountdown.astro';
import RandomPicker from '../components/RandomPicker.astro';
import CurrencyExchange from '../components/CurrencyExchange.astro';
import PrivateDouban from '../components/PrivateDouban.astro';
import DutyRoster from '../components/DutyRoster.astro';
import WorldMap from '../components/WorldMap.astro';
import ShoppingCompare from '../components/ShoppingCompare.astro';
import ElectricalCalc from '../components/ElectricalCalc.astro';
import XingtaiWeather from '../components/XingtaiWeather.astro';
import HotTopics from '../components/HotTopics.astro';
import Footer from '../components/Footer.astro';
import type { NewsItem, Category, WallpaperData, FootballData, SteamData, BilibiliData, KnowledgeItem, KnowledgeList, DigestData, HotTopic } from '../lib/types';
import { CATEGORY_LABELS, CATEGORY_EMOJIS, ALL_CATEGORIES } from '../lib/types';
import allNewsData from '../data/news.json';
import wallpaperData from '../data/wallpapers.json';
import wallpaperGirlData from '../data/wallpapers-girl.json';
import footballData from '../data/football.json';
import steamData from '../data/steam.json';
import bilibiliData from '../data/bilibili.json';
import knowledgeData from '../data/knowledge.json';
import digestData from '../data/digest.json';
import hotTopicsData from '../data/hot-topics.json';

const allNews = allNewsData as NewsItem[];
const wallpapers = wallpaperData as WallpaperData;
const wallpapersGirl = wallpaperGirlData as WallpaperData;
const football = footballData as FootballData;
const steam = steamData as SteamData;
const bilibili = bilibiliData as BilibiliData;
const knowledge = knowledgeData as KnowledgeList | null;
const digest = digestData as DigestData;
const hotTopics = hotTopicsData as HotTopic[];

// --- Compute Related Articles (same as before) ---
const commonWords = new Set([
  'the', 'a', 'an', 'and', 'or', 'but', 'in', 'on', 'at', 'to', 'for', 'of',
  'with', 'by', 'from', 'is', 'are', 'was', 'were', 'be', 'been', 'has', 'have',
  'had', 'do', 'does', 'did', 'will', 'would', 'can', 'could', 'may', 'might',
  'this', 'that', 'these', 'those', 'its', 'it', 'we', 'they', 'he', 'she',
  'not', 'no', 'all', 'new', 'how', 'why', 'what', 'who', 'which', 'up', 'out',
]);

function extractKeywords(title) {
  const cleaned = title.toLowerCase().replace(/[^\w一-鿿]/g, ' ');
  const tokens = [];
  for (const word of cleaned.split(/\s+/)) {
    if (word.length >= 3 && !commonWords.has(word)) tokens.push(word);
  }
  const chineseChars = title.match(/[一-鿿]/g) || [];
  for (let i = 0; i < chineseChars.length - 1; i++) {
    tokens.push(chineseChars[i] + chineseChars[i + 1]);
  }
  return [...new Set(tokens)];
}

function getRelated(item, all, max = 3) {
  const tokens = extractKeywords(item.title);
  if (tokens.length === 0) return [];
  const scored = all
    .filter((n) => n.id !== item.id && n.category === item.category)
    .map((n) => {
      const otherTokens = extractKeywords(n.title);
      const overlap = tokens.filter((t) => otherTokens.includes(t)).length;
      return { item: n, score: overlap };
    })
    .filter((n) => n.score > 0);
  scored.sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    return new Date(b.item.publishedAt).getTime() - new Date(a.item.publishedAt).getTime();
  });
  return scored.slice(0, max).map((s) => s.item);
}

const relatedMap = new Map<string, NewsItem[]>();
allNews.forEach((item) => {
  relatedMap.set(item.id, getRelated(item, allNews));
});

// Hybrid rendering: first page static HTML, rest lazy-loaded from JSON
const INITIAL_PAGE_SIZE = 10;
const initialItems = allNews.slice(0, INITIAL_PAGE_SIZE);
const initialRelatedMap = new Map<string, NewsItem[]>();
initialItems.forEach((item) => {
  initialRelatedMap.set(item.id, relatedMap.get(item.id) || []);
});
// Serializable lookup for client-side dynamic card rendering
const relatedLookup: Record<string, { t: string; u: string }[]> = {};
for (const [id, items] of relatedMap) {
  relatedLookup[id] = items.map((r) => ({ t: r.title, u: r.url }));
}
---

<BaseLayout title="AI News Hub - 个人仪表盘">
  <Wallpaper data={wallpapers} />

  <main class="max-w-6xl mx-auto px-4 py-6">
    <!-- Football Standings (full width, collapsed by default) -->
    <FootballStandings
      standings={football.standings}
      lastMatch={football.lastMatch}
      nextMatch={football.nextMatch}
    />

    <!-- Two-Column Layout: Main Dashboard + Right Sidebar -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-4">
      <!-- Left: Personal Dashboard -->
      <div class="space-y-4">
        <!-- Personal tools row 1: DailyDigest + SalaryCountdown -->
        <div class="grid grid-cols-1 xl:grid-cols-3 gap-4">
          <DailyDigest data={digest} />
          <XingtaiWeather />
          <SalaryCountdown />
        </div>

        <!-- Private Douban -->
        <PrivateDouban />

        <!-- Stock Market -->
        <StockMarket />

        <!-- Category Nav (full width) -->
        <nav class="mb-2 overflow-x-auto">
          <div class="flex gap-2 min-w-max" id="category-nav">
            <button data-cat="" class="cat-btn px-4 py-1.5 rounded-full text-sm font-medium whitespace-nowrap bg-blue-600 text-white transition-colors">
              📰 全部
            </button>
            {ALL_CATEGORIES.map((key) => (
              <button
                data-cat={key}
                class="cat-btn px-4 py-1.5 rounded-full text-sm font-medium whitespace-nowrap bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
              >
                {CATEGORY_EMOJIS[key]} {CATEGORY_LABELS[key]}
              </button>
            ))}
          </div>
        </nav>

        <!-- News (collapsible, default expanded) -->
        <details class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 overflow-hidden shadow-sm" open>
          <summary class="bg-gradient-to-r from-blue-600 to-blue-700 px-4 py-3 cursor-pointer text-sm font-bold text-white hover:from-blue-500 hover:to-blue-600 transition-all list-none flex items-center gap-2 [&::-webkit-details-marker]:hidden">
            <span aria-hidden="true">🗞️</span> 新闻资讯
          </summary>
          <div class="p-4">
            <!-- Search -->
            <form action="/search" method="get" class="mb-3">
              <div class="relative">
                <input
                  type="search"
                  name="q"
                  aria-label="搜索"
                  placeholder="搜索新闻..."
                  class="w-full px-4 py-2.5 pl-10 rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow"
                />
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </div>
            </form>

            <!-- News Cards -->
            <div id="news-list" class="space-y-3 pb-4">
              {initialItems.map((item) => (
                <div class="news-item" data-category={item.category}>
                  <NewsCard item={item} relatedItems={initialRelatedMap.get(item.id) || []} />
                </div>
              ))}
              {initialItems.length === 0 && (
                <p class="text-center text-gray-400 py-12">暂无新闻</p>
              )}
            </div>
            <!-- Pagination -->
            <div id="pagination" class="flex items-center justify-center gap-2 pb-8 text-sm">
              <button id="pg-first" class="px-3 py-1.5 rounded-lg bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors disabled:opacity-30 disabled:cursor-not-allowed text-xs font-medium">
                首页
              </button>
              <button id="pg-prev" class="px-3 py-1.5 rounded-lg bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors disabled:opacity-30 disabled:cursor-not-allowed text-xs font-medium">
                ← 上一页
              </button>
              <span id="pg-info" class="px-3 py-1.5 text-xs text-gray-500 dark:text-gray-400 tabular-nums">
                1 / 1
              </span>
              <button id="pg-next" class="px-3 py-1.5 rounded-lg bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors disabled:opacity-30 disabled:cursor-not-allowed text-xs font-medium">
                下一页 →
              </button>
              <button id="pg-last" class="px-3 py-1.5 rounded-lg bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors disabled:opacity-30 disabled:cursor-not-allowed text-xs font-medium">
                尾页
              </button>
            </div>
          </div>
        </details>
      </div>

      <!-- Right: Sidebar (flows below main content on mobile, right column on desktop) -->
      <aside class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-4">
        <NetEaseMusic />
        <DailyKnowledge data={knowledge} />
        <DutyRoster />
        <HotTopics topics={hotTopics} />
        <WallpaperGallery data={wallpapersGirl} title="美女壁纸" emoji="💃" />
        <BilibiliFavorites data={bilibili} />
      </aside>
    </div>

<!-- Bottom: ShoppingCompare + CurrencyExchange + RandomPicker -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-4">
      <ShoppingCompare />
      <CurrencyExchange />
      <RandomPicker />
    </div>

    <!-- WorldMap full width -->
    <div class="mt-4">
      <WorldMap />
    </div>
  </main>
  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>

<script>
  // Constants
  const PER_PAGE = 10;
  const CATEGORY_MAP = {
    ai: { emoji: '🤖', label: 'AI 前沿' },
    tech: { emoji: '💻', label: '科技动态' },
    business: { emoji: '📈', label: '商业财经' },
    gaming: { emoji: '🎮', label: '游戏资讯' },
  };

  // Lazy-loaded data
  let allItems = null;

  // State
  let currentCat = '';
  let currentPage = 1;

  // DOM refs
  const newsList = document.getElementById('news-list');
  const catBtns = document.querySelectorAll('.cat-btn');
  const pgFirst = document.getElementById('pg-first');
  const pgPrev = document.getElementById('pg-prev');
  const pgNext = document.getElementById('pg-next');
  const pgLast = document.getElementById('pg-last');
  const pgInfo = document.getElementById('pg-info');

  function escapeHtml(s) {
    if (!s) return '';
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function formatDate(dateStr) {
    const d = new Date(dateStr);
    const now = new Date();
    return d.getFullYear() === now.getFullYear()
      ? d.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' })
      : d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' });
  }

  function loadAllData() {
    if (allItems) return Promise.resolve();
    return import('../data/news.json').then(function(mod) {
      allItems = mod.default || mod;
    });
  }

  // Build all lazy-loaded cards on first pagination interaction
  function ensureAllRendered() {
    const existing = newsList.querySelectorAll('.news-item');
    if (existing.length >= allItems.length) return;

    const frag = document.createDocumentFragment();
    for (let i = existing.length; i < allItems.length; i++) {
      const item = allItems[i];
      const div = document.createElement('div');
      div.className = 'news-item';
      div.dataset.category = item.category;
      div.style.display = 'none';
      div.innerHTML = renderCard(item);
      frag.appendChild(div);
    }
    newsList.appendChild(frag);
  }

  function renderCard(item) {
    const cat = CATEGORY_MAP[item.category] || { emoji: '📄', label: item.category || '' };
    const catBadge = `<span class="ml-auto px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400">${cat.emoji} ${cat.label}</span>`;

    const thumb = item.imageUrl
      ? `<img src="${escapeHtml(item.imageUrl)}" alt="" class="w-16 h-16 rounded-lg object-cover flex-shrink-0 bg-gray-100 dark:bg-gray-800" loading="lazy" onerror="this.style.display='none'" />`
      : '';

    let stars = '';
    if (item.type === 'repo' && item.stars != null) {
      stars = `<span>·</span><span>⭐ ${item.stars.toLocaleString()}</span>`;
    }
    let lang = '';
    if (item.type === 'repo' && item.language) {
      lang = `<span>·</span><span>${escapeHtml(item.language)}</span>`;
    }

    const hasContent = item.fullContent && item.fullContent.length > 0;
    const contentBody = hasContent
      ? `<div class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed mb-4 whitespace-pre-wrap">${escapeHtml(item.fullContent)}</div>`
      : '<p class="text-sm text-gray-400 dark:text-gray-500 mb-4 italic">暂无详细内容</p>';

    const expandedImg = item.imageUrl
      ? `<img src="${escapeHtml(item.imageUrl)}" alt="" class="w-full max-h-64 object-cover rounded-lg mb-4 bg-gray-100 dark:bg-gray-800" loading="lazy" onerror="this.style.display='none'" />`
      : '';

    return `<div class="news-card bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 p-4 hover:border-blue-300 dark:hover:border-blue-700 hover:shadow-md transition-all duration-200 cursor-pointer" data-expandable>
    <div class="flex items-start gap-3">
      ${thumb}
      <div class="flex-1 min-w-0">
        <h2 class="text-base font-semibold leading-snug mb-1 line-clamp-2">${escapeHtml(item.title)}</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-2 mb-2">${escapeHtml(item.summary)}</p>
        <div class="flex items-center gap-2 text-xs text-gray-400 dark:text-gray-500 flex-wrap">
          <span>${escapeHtml(item.source)}</span>
          <span>·</span>
          <span>${formatDate(item.publishedAt)}</span>
          ${stars}${lang}
          ${catBadge}
        </div>
      </div>
    </div>
    <div class="expanded-content mt-4 pt-4 border-t border-gray-200 dark:border-gray-700 hidden">
      ${expandedImg}
      ${contentBody}
      <div class="flex items-center justify-between text-xs text-gray-400 dark:text-gray-500 pt-3 border-t border-gray-100 dark:border-gray-800">
        <span>📎 出处: ${escapeHtml(item.source)}</span>
        <a href="${escapeHtml(item.url)}" target="_blank" rel="noopener noreferrer" class="text-blue-500 hover:text-blue-600 hover:underline">查看原文 →</a>
      </div>
    </div>
  </div>`;
  }

  function getVisibleIndices() {
    if (!allItems) return [];
    const indices = [];
    for (let i = 0; i < allItems.length; i++) {
      if (!currentCat || allItems[i].category === currentCat) {
        indices.push(i);
      }
    }
    return indices;
  }

  async function renderPage() {
    await loadAllData();
    const visible = getVisibleIndices();
    const totalPages = Math.max(1, Math.ceil(visible.length / PER_PAGE));
    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;
    const start = (currentPage - 1) * PER_PAGE;
    const end = Math.min(start + PER_PAGE, visible.length);
    const pageIndices = visible.slice(start, end);

    // Build lazy cards on first pagination interaction
    if (pageIndices.length > 0) {
      ensureAllRendered();
    }

    const allDivs = newsList.querySelectorAll('.news-item');
    for (let i = 0; i < allDivs.length; i++) {
      allDivs[i].style.display = pageIndices.includes(i) ? '' : 'none';
    }

    pgInfo.textContent = `${currentPage} / ${totalPages}`;
    pgFirst.disabled = currentPage <= 1;
    pgPrev.disabled = currentPage <= 1;
    pgNext.disabled = currentPage >= totalPages;
    pgLast.disabled = currentPage >= totalPages;
  }

  async function goToPage(page) {
    await loadAllData();
    const visible = getVisibleIndices();
    const totalPages = Math.max(1, Math.ceil(visible.length / PER_PAGE));
    currentPage = Math.max(1, Math.min(page, totalPages));
    await renderPage();
    newsList.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // Category filter buttons
  catBtns.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const cat = btn.dataset.cat || '';
      currentCat = cat;
      catBtns.forEach((b) => {
        b.classList.remove('bg-blue-600', 'text-white');
        b.classList.add('bg-gray-100', 'dark:bg-gray-800', 'text-gray-600', 'dark:text-gray-300', 'hover:bg-gray-200', 'dark:hover:bg-gray-700');
      });
      btn.classList.remove('bg-gray-100', 'dark:bg-gray-800', 'text-gray-600', 'dark:text-gray-300', 'hover:bg-gray-200', 'dark:hover:bg-gray-700');
      btn.classList.add('bg-blue-600', 'text-white');
      currentPage = 1;
      await renderPage();
    });
  });

  // Pagination buttons
  pgFirst.addEventListener('click', () => goToPage(1));
  pgPrev.addEventListener('click', () => goToPage(currentPage - 1));
  pgNext.addEventListener('click', () => goToPage(currentPage + 1));
  pgLast.addEventListener('click', async () => {
    await loadAllData();
    const visible = getVisibleIndices();
    const totalPages = Math.max(1, Math.ceil(visible.length / PER_PAGE));
    await goToPage(totalPages);
  });

  // Initial render (uses static data for first page, defers lazy build)
  loadAllData().then(function() {
    renderPage();
  });

</script>
