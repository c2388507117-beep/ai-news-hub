---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import Footer from '../components/Footer.astro';
import type { NewsItem } from '../lib/types';
import allNewsData from '../data/news.json';

const allNews = allNewsData as NewsItem[];

const now = new Date();
const weekAgo = now.getTime() - 7 * 24 * 60 * 60 * 1000;

// Filter to last 7 days, then organize by category
const weeklyItems = allNews.filter((item) => {
  const t = new Date(item.publishedAt).getTime();
  return !isNaN(t) && t >= weekAgo;
});

// Group by category
const byCategory: Record<string, NewsItem[]> = {};
for (const item of weeklyItems) {
  const cat = item.category;
  if (!byCategory[cat]) byCategory[cat] = [];
  byCategory[cat].push(item);
}

const CATEGORY_NAMES: Record<string, string> = {
  ai: '🤖 AI 前沿',
  tech: '💻 科技动态',
  business: '📈 商业财经',
  gaming: '🎮 游戏资讯',
  trending: '📦 热门项目',
};

function formatDate(dateStr: string): string {
  const d = new Date(dateStr);
  return d.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' });
}
---

<BaseLayout title="AI News Hub - 本周热门">
  <main class="max-w-4xl mx-auto px-4 py-6">
    <div class="mb-6">
      <h1 class="text-2xl font-bold mb-1">📊 本周热门</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400">
        {formatDate(new Date(weekAgo).toISOString())} — {formatDate(now.toISOString())}
        &nbsp;·&nbsp; 共 {weeklyItems.length} 篇
      </p>
    </div>

    {Object.entries(byCategory).length > 0 ? (
      Object.entries(byCategory).map(([cat, items]) => (
        <section class="mb-8">
          <h2 class="text-lg font-semibold mb-3 text-gray-700 dark:text-gray-300">
            {CATEGORY_NAMES[cat] || cat}
            <span class="text-sm font-normal text-gray-400 ml-2">{items.length} 篇</span>
          </h2>
          <div class="space-y-3">
            {items.sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime()).map((item) => (
              <NewsCard item={item} />
            ))}
          </div>
        </section>
      ))
    ) : (
      <p class="text-center text-gray-400 py-12">本周暂无内容</p>
    )}
  </main>
  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>
