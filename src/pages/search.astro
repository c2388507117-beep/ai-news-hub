---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import type { NewsItem } from '../lib/types';
import allNewsData from '../data/news.json';

const allNews = allNewsData as NewsItem[];
---

<BaseLayout title="AI News Hub - 搜索">
  <main class="max-w-4xl mx-auto px-4 py-6">
    <form id="search-form" class="mb-6">
      <div class="relative">
        <input
          type="search"
          name="q"
          id="search-input"
          aria-label="搜索"
          placeholder="搜索 AI 新闻..."
          class="w-full px-4 py-2.5 pl-10 rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
        />
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </form>
    <div id="search-results">
      <p class="text-center text-gray-400 py-12">输入关键词搜索新闻</p>
    </div>
  </main>
  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>

<script>
import allNews from '../data/news.json';

const container = document.getElementById('search-results');
const input = document.getElementById('search-input');

function escapeHtml(s) {
  if (!s) return '';
  return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function renderCard(item) {
  const d = new Date(item.publishedAt);
  const dateStr = d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
  const imageHtml = item.imageUrl
    ? `<img src="${escapeHtml(item.imageUrl)}" alt="" class="w-20 h-14 object-cover rounded-lg flex-shrink-0" />`
    : '';

  return `<div class="p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900">
    <div class="flex gap-4">
      ${imageHtml ? `<a href="${escapeHtml(item.url)}" target="_blank" rel="noopener noreferrer" class="flex-shrink-0">${imageHtml}</a>` : ''}
      <div class="min-w-0 flex-1">
        <a href="${escapeHtml(item.url)}" target="_blank" rel="noopener noreferrer" class="block group">
          <h2 class="text-base font-semibold leading-snug mb-1.5 text-gray-900 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">${escapeHtml(item.title)}</h2>
        </a>
        ${item.summary ? `<p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-2 mb-2">${escapeHtml(item.summary)}</p>` : ''}
        <div class="flex items-center gap-3 text-xs text-gray-400 dark:text-gray-500">
          <span>${escapeHtml(item.source)}</span>
          <span>${dateStr}</span>
        </div>
      </div>
    </div>
  </div>`;
}

function renderResults(query) {
  const q = query.trim().toLowerCase();
  if (!q) {
    container.innerHTML = '<p class="text-center text-gray-400 py-12">输入关键词搜索新闻</p>';
    return;
  }

  const results = allNews.filter(
    (item) =>
      item.title.toLowerCase().includes(q) ||
      item.summary.toLowerCase().includes(q) ||
      item.source.toLowerCase().includes(q)
  );

  if (results.length === 0) {
    container.innerHTML = `<p class="text-sm text-gray-500 mb-4">没有找到关于 &quot;${escapeHtml(query)}&quot; 的结果</p>`;
    return;
  }

  container.innerHTML =
    `<p class="text-sm text-gray-500 mb-4">找到 ${results.length} 条关于 &quot;${escapeHtml(query)}&quot; 的结果</p>` +
    `<div class="space-y-3">${results.map(renderCard).join('')}</div>`;
}

// Handle form submit
document.getElementById('search-form').addEventListener('submit', (e) => {
  e.preventDefault();
  const q = input.value;
  const url = q ? `?q=${encodeURIComponent(q)}` : window.location.pathname;
  history.pushState({ q }, '', url);
  renderResults(q);
});

// Handle initial load from URL
const params = new URLSearchParams(location.search);
const initialQ = params.get('q') || '';
if (initialQ) {
  input.value = initialQ;
  renderResults(initialQ);
}

// Handle back/forward navigation
window.addEventListener('popstate', () => {
  const p = new URLSearchParams(location.search);
  const q = p.get('q') || '';
  input.value = q;
  renderResults(q);
});
</script>
