---
import type { WallpaperData } from '../lib/types';

export interface Props {
  data: WallpaperData;
}

const { data } = Astro.props;
const hasWallpapers = data?.urls && data.urls.length > 0;

// Pick wallpaper deterministically by day of year at build time
let wallpaperUrl = '';
let fallbackUrl = '';
if (hasWallpapers) {
  const urls = data.urls.map((u) => (typeof u === 'string' ? u : u.url));
  const now = new Date();
  const start = new Date(now.getFullYear(), 0, 0);
  const diff = now - start;
  const dayOfYear = Math.floor(diff / (1000 * 60 * 60 * 24));
  const idx = dayOfYear % urls.length;
  wallpaperUrl = urls[idx];
  fallbackUrl = urls[(idx + 1) % urls.length] || wallpaperUrl;
}
---

{hasWallpapers && (
  <link rel="preload" href={wallpaperUrl} as="image" />
)}

{hasWallpapers && <script is:inline data-wp={wallpaperUrl} data-fb={fallbackUrl}>
  var W = document.currentScript, wp = W.getAttribute('data-wp');
  if (wp) {
    document.body.style.backgroundImage = 'url("' + wp + '")';
    document.body.style.backgroundSize = 'cover';
    document.body.style.backgroundPosition = 'center';
    document.body.style.backgroundAttachment = 'fixed';
    document.body.style.backgroundRepeat = 'no-repeat';
  }
</script>}
