---
// TechTimeline — 科技大事件时间线
// Shows notable news organized by month from the last 30 days

import type { NewsItem } from '../lib/types';
import { CATEGORY_LABELS, CATEGORY_EMOJIS } from '../lib/types';

export interface Props {
  items: NewsItem[];
}

const { items } = Astro.props;

// Only last 30 days
const cutoff = Date.now() - 30 * 24 * 60 * 60 * 1000;
const recent = (items || [])
  .filter(item => new Date(item.publishedAt).getTime() >= cutoff)
  .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime())
  .slice(0, 12);

// Group by month
const byMonth: Record<string, NewsItem[]> = {};
for (const item of recent) {
  const monthKey = item.publishedAt.slice(0, 7); // "2026-06"
  if (!byMonth[monthKey]) byMonth[monthKey] = [];
  byMonth[monthKey].push(item);
}

const months = Object.keys(byMonth).sort().reverse();

function monthLabel(key: string): string {
  const d = new Date(key + '-01T00:00:00');
  return d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long' });
}

function fmtMD(dateStr: string): string {
  const d = new Date(dateStr);
  return (d.getMonth() + 1) + '/' + d.getDate();
}
---

<div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 overflow-hidden shadow-sm">
  <div class="bg-gradient-to-r from-gray-700 to-gray-900 dark:from-gray-600 dark:to-gray-800 px-4 py-3">
    <h3 class="text-sm font-bold text-white flex items-center gap-2">
      <span aria-hidden="true">🏛️</span> 科技大事件
    </h3>
  </div>
  {months.length > 0 ? (
    <div class="relative pl-8 pr-4 py-3">
      <div class="absolute left-[18px] top-0 bottom-0 w-0.5 bg-gray-200 dark:bg-gray-700"></div>
      {months.map((month) => (
        <div class="mb-4 last:mb-0 relative">
          <div class="absolute -left-[22px] top-1 w-3 h-3 rounded-full bg-gray-500 dark:bg-gray-400 border-2 border-white dark:border-gray-900"></div>
          <p class="text-[11px] font-semibold text-gray-500 dark:text-gray-400 mb-2">{monthLabel(month)}</p>
          <div class="space-y-2">
            {byMonth[month].slice(0, 4).map((item) => {
              const catEmoji = CATEGORY_EMOJIS[item.category as keyof typeof CATEGORY_EMOJIS] || '📄';
              const catLabel = CATEGORY_LABELS[item.category as keyof typeof CATEGORY_LABELS] || '';
              return (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block -mx-2 px-2 py-1.5 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800/30 transition-colors"
                >
                  <div class="flex items-center gap-1 text-[10px] text-gray-400 mb-0.5">
                    <span>{catEmoji}</span>
                    <span>{fmtMD(item.publishedAt)}</span>
                    <span>·</span>
                    <span class="truncate">{item.source}</span>
                  </div>
                  <p class="text-xs font-medium text-gray-800 dark:text-gray-200 leading-snug line-clamp-2">{item.title}</p>
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  ) : (
    <p class="text-center text-gray-400 py-6 text-xs">暂无事件</p>
  )}
</div>
