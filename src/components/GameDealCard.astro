---
// GameDealCard — Steam 游戏打折卡片（国区，¥ 价格）

export interface GameDeal {
  id: string;
  title: string;
  url: string;
  discount: number;
  originalPrice: number;
  finalPrice: number;
  currency: string;
  region: string;
  imageUrl: string;
  platform: string;
  publishedAt: string;
}

export interface Props { items: GameDeal[]; }

const { items } = Astro.props;
if (items.length > 9) items.sort((a, b) => b.discount - a.discount);

function fmtPrice(p: number): string {
  if (p <= 0) return '';
  return p.toFixed(2);
}
---

<div class="space-y-2">
  {items.length > 0 ? (
    items.slice(0, 24).map((item) => (
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 p-3 rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 hover:border-green-300 dark:hover:border-green-700 hover:shadow-md transition-all"
      >
        <img
          src={item.imageUrl}
          alt=""
          class="w-20 h-[60px] rounded-lg object-cover flex-shrink-0 bg-gray-200 dark:bg-gray-700"
          loading="lazy"
          onerror="this.style.display='none'"
        />
        <div class="flex-1 min-w-0">
          <h3 class="text-sm font-semibold leading-snug line-clamp-2 text-gray-800 dark:text-gray-200">{item.title}</h3>
          <div class="flex items-center gap-2.5 mt-2 flex-wrap">
            <span class="text-xs font-bold text-white bg-red-500 px-2 py-0.5 rounded">-{item.discount}%</span>
            {item.finalPrice > 0 && (
              <>
                <span class="text-sm font-bold text-gray-800 dark:text-gray-200">¥{fmtPrice(item.finalPrice)}</span>
                {item.originalPrice > item.finalPrice && (
                  <span class="text-[11px] text-gray-400 line-through">¥{fmtPrice(item.originalPrice)}</span>
                )}
              </>
            )}
            <span class="text-[10px] text-gray-400 ml-auto">{item.region}</span>
          </div>
        </div>
      </a>
    ))
  ) : (
    <p class="text-center text-gray-400 py-6 text-xs">暂无折扣信息</p>
  )}
</div>
