---
// PowerPolicy — 电力行业政策安规

export interface PowerPolicyItem {
  date: string;
  title: string;
  desc: string;
  tag: string;
}

export interface Props { items: PowerPolicyItem[]; }

const { items } = Astro.props;
const sorted = (items || []).sort((a, b) => b.date.localeCompare(a.date));

const TAG_COLORS: Record<string, string> = {
  安规: 'bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300',
  政策: 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300',
};
---

<div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 overflow-hidden shadow-sm">
  <div class="bg-gradient-to-r from-orange-600 to-red-600 px-4 py-3">
    <h3 class="text-sm font-bold text-white flex items-center gap-2">
      <span aria-hidden="true">⚡</span> 电力行业
    </h3>
  </div>
  {sorted.length > 0 ? (
    <div class="relative pl-8 pr-4 py-3 space-y-3">
      <div class="absolute left-[18px] top-0 bottom-0 w-0.5 bg-gray-200 dark:bg-gray-700"></div>
      {sorted.map((item) => (
        <div class="relative">
          <div class="absolute -left-[22px] top-1 w-3 h-3 rounded-full bg-orange-500 dark:bg-orange-400 border-2 border-white dark:border-gray-900"></div>
          <div class="flex items-center gap-1.5">
            <span class="text-[10px] text-gray-400 tabular-nums">{item.date}</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded {TAG_COLORS[item.tag] || 'bg-gray-100 text-gray-600'}">{item.tag}</span>
          </div>
          <p class="text-xs font-semibold text-gray-800 dark:text-gray-200 mt-0.5">{item.title}</p>
          <p class="text-[11px] text-gray-500 dark:text-gray-400 line-clamp-2">{item.desc}</p>
        </div>
      ))}
    </div>
  ) : (
    <p class="text-center text-gray-400 py-6 text-xs">暂无数据</p>
  )}
</div>
