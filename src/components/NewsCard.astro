---
import type { NewsItem } from '../lib/types';
import { CATEGORY_LABELS, CATEGORY_EMOJIS } from '../lib/types';

export interface Props {
  item: NewsItem;
}

const { item } = Astro.props;
const catLabel = CATEGORY_LABELS[item.category] || item.category;
const catEmoji = CATEGORY_EMOJIS[item.category] || '📄';

function formatDate(dateStr: string): string {
  const d = new Date(dateStr);
  const now = new Date();
  const isThisYear = d.getFullYear() === now.getFullYear();
  if (isThisYear) {
    return d.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' });
  }
  return d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<a
  href={item.url}
  target="_blank"
  rel="noopener noreferrer"
  class="block bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800
         p-4 hover:border-blue-300 dark:hover:border-blue-700 hover:shadow-md
         transition-all duration-200"
>
  <div class="flex items-start gap-3">
    {item.imageUrl && (
      <img
        src={item.imageUrl}
        alt=""
        class="w-16 h-16 rounded-lg object-cover flex-shrink-0 bg-gray-100 dark:bg-gray-800"
        loading="lazy"
      />
    )}
    <div class="flex-1 min-w-0">
      <h2 class="text-base font-semibold leading-snug mb-1 line-clamp-2">
        {item.title}
      </h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-2 mb-2">
        {item.summary}
      </p>
      <div class="flex items-center gap-2 text-xs text-gray-400 dark:text-gray-500 flex-wrap">
        <span>{item.source}</span>
        <span>·</span>
        <span>{formatDate(item.publishedAt)}</span>
        {item.type === 'repo' && item.stars != null && (
          <>
            <span>·</span>
            <span>⭐ {item.stars.toLocaleString()}</span>
          </>
        )}
        {item.type === 'repo' && item.language && (
          <>
            <span>·</span>
            <span>{item.language}</span>
          </>
        )}
        <span class="ml-auto px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400">
          {catEmoji} {catLabel}
        </span>
      </div>
    </div>
  </div>
</a>
