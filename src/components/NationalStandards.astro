---
// NationalStandards — 国标每日学习（可点击展开详情）

export interface StandardItem { id: string; title: string; category: string; }
export interface Props { items: StandardItem[]; }

const { items } = Astro.props;
const allStandards = items || [];

const now = new Date();
const startOfYear = new Date(now.getFullYear(), 0, 0);
const dayOfYear = Math.floor((now.getTime() - startOfYear.getTime()) / (1000 * 60 * 60 * 24));
const count = allStandards.length;

let todayItems: StandardItem[] = [];
if (count > 0) {
  const start = (dayOfYear * 3) % count;
  for (let i = 0; i < Math.min(3, count); i++) {
    todayItems.push(allStandards[(start + i) % count]);
  }
}

const CATEGORY_COLORS: Record<string, string> = {
  安规: 'bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300',
  安全: 'bg-orange-100 text-orange-700 dark:bg-orange-900/40 dark:text-orange-300',
  电气: 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300',
  高压: 'bg-purple-100 text-purple-700 dark:bg-purple-900/40 dark:text-purple-300',
  配电: 'bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300',
  施工: 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900/40 dark:text-yellow-300',
  继保: 'bg-pink-100 text-pink-700 dark:bg-pink-900/40 dark:text-pink-300',
  变电: 'bg-teal-100 text-teal-700 dark:bg-teal-900/40 dark:text-teal-300',
  试验: 'bg-cyan-100 text-cyan-700 dark:bg-cyan-900/40 dark:text-cyan-300',
};

function color(cat: string): string {
  return CATEGORY_COLORS[cat] || 'bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-300';
}
---

<div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 overflow-hidden shadow-sm">
  <div class="bg-gradient-to-r from-slate-700 to-slate-900 dark:from-slate-600 dark:to-slate-800 px-4 py-3">
    <h3 class="text-sm font-bold text-white flex items-center gap-2">
      <span aria-hidden="true">📋</span> 国标每日学
    </h3>
  </div>
  {todayItems.length > 0 ? (
    <div class="divide-y divide-gray-100 dark:divide-gray-800" id="gb-list">
      {todayItems.map((std, idx) => (
        <div class="gb-item">
          <button
            class="w-full text-left px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-800/30 transition-colors cursor-pointer"
            data-gb-target={`gb-detail-${idx}`}
            aria-expanded="false"
          >
            <div class="flex items-start justify-between gap-2">
              <span class="text-[11px] font-mono font-bold text-slate-600 dark:text-slate-400 flex-shrink-0 mt-0.5">{std.id}</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded {color(std.category)} flex-shrink-0">{std.category}</span>
            </div>
            <p class="text-xs text-gray-800 dark:text-gray-200 mt-1 leading-relaxed text-left">{std.title}</p>
          </button>
          <div id={`gb-detail-${idx}`} class="hidden px-4 pb-3 pt-0 text-xs text-gray-500 dark:text-gray-400 leading-relaxed space-y-1">
            <p><span class="font-medium text-gray-700 dark:text-gray-300">标准号：</span>{std.id}</p>
            <p><span class="font-medium text-gray-700 dark:text-gray-300">名称：</span>{std.title}</p>
            <p><span class="font-medium text-gray-700 dark:text-gray-300">分类：</span>{std.category}</p>
          </div>
        </div>
      ))}
      <div class="px-4 py-2 bg-gray-50 dark:bg-gray-800/50 text-[10px] text-gray-400 text-center">
        共 {count} 条国标 · 点击展开详情 · 每天 3 条自动轮换
      </div>
    </div>
  ) : (
    <p class="text-center text-gray-400 py-6 text-xs">暂无国标数据</p>
  )}
</div>

<script>
  document.querySelectorAll('[data-gb-target]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var targetId = this.getAttribute('data-gb-target');
      var detail = document.getElementById(targetId);
      if (!detail) return;
      var isOpen = !detail.classList.contains('hidden');
      detail.classList.toggle('hidden');
      this.setAttribute('aria-expanded', String(!isOpen));
    });
  });
</script>
