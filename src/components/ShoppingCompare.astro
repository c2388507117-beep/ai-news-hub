---

---

<div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 overflow-hidden shadow-sm">
  <!-- Toggle header -->
  <button
    id="shop-toggle"
    class="w-full bg-gradient-to-r from-red-500 to-pink-500 px-4 py-3 flex items-center justify-between cursor-pointer hover:from-red-400 hover:to-pink-400 transition-all text-left"
    aria-expanded="false"
    aria-controls="shop-body"
  >
    <div class="flex items-center gap-2 min-w-0">
      <span class="text-xl leading-none flex-shrink-0" aria-hidden="true">🛍️</span>
      <h2 class="text-sm font-bold text-white truncate">购物比价</h2>
      <span id="shop-summary" class="text-xs text-white/70 truncate hidden"></span>
    </div>
    <span id="shop-chevron" class="text-white/80 text-lg transition-transform duration-200 flex-shrink-0">▶</span>
  </button>

  <!-- Body (collapsed by default) -->
  <div id="shop-body" class="hidden">
    <div class="p-4">
      <!-- Search input -->
      <div class="flex gap-2 mb-3">
        <input
          id="shop-input"
          type="text"
          placeholder="输入商品名称..."
          class="flex-1 text-sm px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-1 focus:ring-red-500"
        />
        <button
          id="shop-search-btn"
          class="px-4 py-2 rounded-lg bg-gradient-to-r from-red-500 to-pink-500 text-white text-sm font-medium hover:from-red-400 hover:to-pink-400 transition-colors whitespace-nowrap"
        >
          比价
        </button>
      </div>

      <!-- Default state (shown before any search) -->
      <div id="shop-default" class="text-center py-6">
        <span class="text-3xl" aria-hidden="true">🔍</span>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">输入商品名称，一键比价</p>
      </div>

      <!-- Platform buttons (hidden until search) -->
      <div id="shop-platforms" class="hidden">
        <p id="shop-query-display" class="text-xs text-gray-500 dark:text-gray-400 mb-3 truncate"></p>
        <div class="grid grid-cols-2 gap-2">
          <!-- 淘宝 -->
          <a
            id="shop-taobao"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-3 py-2.5 rounded-lg bg-orange-50 dark:bg-orange-900/10 text-orange-700 dark:text-orange-300 hover:bg-orange-100 dark:hover:bg-orange-900/20 transition-colors text-sm font-medium"
          >
            <span class="text-base" aria-hidden="true">🛒</span>
            <span>淘宝</span>
          </a>
          <!-- 京东 -->
          <a
            id="shop-jd"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-3 py-2.5 rounded-lg bg-red-50 dark:bg-red-900/10 text-red-700 dark:text-red-300 hover:bg-red-100 dark:hover:bg-red-900/20 transition-colors text-sm font-medium"
          >
            <span class="text-base" aria-hidden="true">📦</span>
            <span>京东</span>
          </a>
          <!-- 拼多多 -->
          <a
            id="shop-pdd"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-3 py-2.5 rounded-lg bg-green-50 dark:bg-green-900/10 text-green-700 dark:text-green-300 hover:bg-green-100 dark:hover:bg-green-900/20 transition-colors text-sm font-medium"
          >
            <span class="text-base" aria-hidden="true">🧧</span>
            <span>拼多多</span>
          </a>
          <!-- 什么值得买 -->
          <a
            id="shop-smzdm"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-3 py-2.5 rounded-lg bg-blue-50 dark:bg-blue-900/10 text-blue-700 dark:text-blue-300 hover:bg-blue-100 dark:hover:bg-blue-900/20 transition-colors text-sm font-medium"
          >
            <span class="text-base" aria-hidden="true">🏷️</span>
            <span>什么值得买</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    const toggle = document.getElementById('shop-toggle');
    const body = document.getElementById('shop-body');
    const chevron = document.getElementById('shop-chevron');
    const summary = document.getElementById('shop-summary');
    const input = document.getElementById('shop-input');
    const searchBtn = document.getElementById('shop-search-btn');
    const defaultEl = document.getElementById('shop-default');
    const platformsEl = document.getElementById('shop-platforms');
    const queryDisplay = document.getElementById('shop-query-display');
    const taobao = document.getElementById('shop-taobao');
    const jd = document.getElementById('shop-jd');
    const pdd = document.getElementById('shop-pdd');
    const smzdm = document.getElementById('shop-smzdm');

    if (!toggle || !body || !chevron || !summary || !input || !searchBtn || !defaultEl || !platformsEl || !queryDisplay || !taobao || !jd || !pdd || !smzdm) {
      throw new Error('ShoppingCompare: missing DOM elements');
    }

    // Platform URL templates
    const PLATFORMS = {
      taobao: 'https://s.taobao.com/search?q={keyword}',
      jd: 'https://search.jd.com/Search?keyword={keyword}',
      pdd: 'https://mobile.yangkeduo.com/search_result.html?search_key={keyword}',
      smzdm: 'https://www.smzdm.com/s/{keyword}',
    };

    // Encode keyword for URL
    function encodeKeyword(keyword) {
      return encodeURIComponent(keyword.trim());
    }

    // Perform search
    function doSearch() {
      const keyword = input.value.trim();
      if (!keyword) {
        input.focus();
        return;
      }

      const encoded = encodeKeyword(keyword);

      // Update platform links
      taobao.href = PLATFORMS.taobao.replace('{keyword}', encoded);
      jd.href = PLATFORMS.jd.replace('{keyword}', encoded);
      pdd.href = PLATFORMS.pdd.replace('{keyword}', encoded);
      smzdm.href = PLATFORMS.smzdm.replace('{keyword}', encoded);

      // Update display
      queryDisplay.textContent = '🔎 "' + keyword + '" 的搜索结果';
      defaultEl.classList.add('hidden');
      platformsEl.classList.remove('hidden');

      // Update summary (shown when collapsed)
      summary.textContent = keyword;
      summary.classList.remove('hidden');
    }

    // Search button click
    searchBtn.addEventListener('click', doSearch);

    // Enter key in input
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        doSearch();
      }
    });

    // Collapsible toggle
    toggle.addEventListener('click', function () {
      const isOpen = !body.classList.contains('hidden');
      body.classList.toggle('hidden');
      chevron.style.transform = isOpen ? '' : 'rotate(90deg)';
      toggle.setAttribute('aria-expanded', String(!isOpen));
    });
  })();
</script>
