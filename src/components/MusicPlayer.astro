---
import type { MusicSong } from '../lib/types';

export interface Props {
  songs: MusicSong[];
}

const { songs } = Astro.props;
const todaySong = songs.length > 0 ? songs[new Date().getDate() % songs.length] : null;
const songsJson = JSON.stringify(songs.map((s) => ({ id: s.id, title: s.title, artist: s.artist })));
---

{todaySong && (
  <div id="music-player" class="fixed top-20 right-4 z-50">
    <button
      id="music-toggle"
      class="w-10 h-10 rounded-full bg-white dark:bg-gray-800 shadow-lg border border-gray-200 dark:border-gray-700 flex items-center justify-center hover:shadow-xl transition-all hover:scale-105"
      title="每日音乐"
      aria-label="播放音乐"
    >
      <span id="music-icon" class="text-lg">🎵</span>
    </button>

    <div id="music-embed" class="hidden mt-2">
      <div class="relative bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 p-3 w-64">
        <button
          id="music-close"
          class="absolute -top-2 -right-2 w-5 h-5 rounded-full bg-gray-700 text-white text-xs flex items-center justify-center hover:bg-gray-600 transition-colors"
          aria-label="关闭音乐"
        >
          ✕
        </button>
        <p class="text-sm font-medium mb-1 pr-4 truncate" id="song-title">{todaySong.title}</p>
        <p class="text-xs text-gray-400 mb-2" id="song-artist">{todaySong.artist}</p>
        <audio id="audio-player" class="w-full h-10" controls preload="none">
          <source id="audio-source" src={`https://music.163.com/song/media/outer/url?id=${todaySong.id}.mp3`} type="audio/mpeg" />
        </audio>
        <p id="music-error" class="text-xs text-red-400 mt-1 hidden">播放失败，请尝试其他歌曲</p>
      </div>
    </div>
  </div>
)}

<script>
  var songs = JSON.parse('{songsJson}');

  const toggle = document.getElementById('music-toggle');
  const embed = document.getElementById('music-embed');
  const closeBtn = document.getElementById('music-close');
  const audio = document.getElementById('audio-player');
  const audioSource = document.getElementById('audio-source');
  const songTitle = document.getElementById('song-title');
  const songArtist = document.getElementById('song-artist');
  const musicIcon = document.getElementById('music-icon');
  const musicError = document.getElementById('music-error');
  let isOpen = false;

  // Today's song index
  const todayIdx = new Date().getDate() % songs.length;
  let currentSongIdx = todayIdx;

  function loadSong(index) {
    const song = songs[index];
    if (!song) return;
    currentSongIdx = index;
    songTitle.textContent = song.title;
    songArtist.textContent = song.artist;
    audioSource.src = `https://music.163.com/song/media/outer/url?id=${song.id}.mp3`;
    audio.load();
    musicError.classList.add('hidden');
  }

  // Try next song on error
  audio.addEventListener('error', () => {
    const nextIdx = (currentSongIdx + 1) % songs.length;
    if (nextIdx === todayIdx) {
      musicError.classList.remove('hidden');
      return;
    }
    loadSong(nextIdx);
    audio.play().catch(() => {});
  });

  toggle.addEventListener('click', () => {
    if (isOpen) {
      embed.classList.add('hidden');
      audio.pause();
      musicIcon.textContent = '🎵';
      isOpen = false;
    } else {
      embed.classList.remove('hidden');
      musicIcon.textContent = '🎶';
      isOpen = true;
      loadSong(currentSongIdx);
      audio.play().catch(() => {});
    }
  });

  closeBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    embed.classList.add('hidden');
    audio.pause();
    musicIcon.textContent = '🎵';
    isOpen = false;
  });
</script>
