---
// 网易云音乐 — Netease Cloud Music inline player
// Uses Netease's outchain embed (works in China)
// Default: 热歌榜 playlist
const defaultPlaylistId = '3778678';
const defaultPlaylistName = '热歌榜';
---

<div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 overflow-hidden shadow-sm">
  <div class="bg-gradient-to-r from-red-600 to-orange-600 px-4 py-3 flex items-center justify-between">
    <h3 class="text-sm font-bold text-white flex items-center gap-2">
      <span aria-hidden="true">🎵</span> 音乐
    </h3>
    <button
      id="music-settings-btn"
      class="text-white/80 hover:text-white text-sm leading-none w-6 h-6 flex items-center justify-center rounded-full hover:bg-white/10 transition-colors"
      title="切换歌单"
    >📋</button>
  </div>

  <div class="p-3">
    <!-- Quick playlist selector -->
    <div id="music-quick-select" class="flex flex-wrap gap-1.5 mb-2">
      <button data-pid="3778678" class="music-pick px-2 py-1 text-xs rounded-full bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400 font-medium transition-colors">🔥 热歌榜</button>
      <button data-pid="3779629" class="music-pick px-2 py-1 text-xs rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">✨ 新歌榜</button>
    </div>

    <!-- Settings (hidden by default) -->
    <div id="music-settings" class="hidden mb-2">
      <label class="text-xs text-gray-500 dark:text-gray-400 block mb-1">自定义歌单 ID:</label>
      <div class="flex gap-1">
        <input
          id="music-playlist-input"
          type="text"
          class="flex-1 px-2 py-1 text-xs rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-1 focus:ring-red-500"
          placeholder="输入歌单ID..."
          value={defaultPlaylistId}
        />
        <button
          id="music-save-btn"
          class="px-2 py-1 text-xs rounded bg-red-600 text-white hover:bg-red-700 transition-colors"
        >保存</button>
      </div>
      <div class="mt-1 text-[10px] text-gray-400 dark:text-gray-500">
        更多歌单: 3777333 歌手榜 · 3778678 热歌榜 · 3779629 新歌榜 · 3779618 飙升榜
      </div>
    </div>

    <!-- Player name display -->
    <div id="music-name" class="text-xs text-gray-400 dark:text-gray-500 mb-2 truncate">
      <span id="music-name-text">🎶 {defaultPlaylistName}</span>
    </div>

    <!-- Netease iframe embed -->
    <iframe
      id="music-iframe"
      src=""
      width="100%"
      height="400"
      class="h-[280px] sm:h-[400px]"
      frameborder="0"
      allowtransparency="true"
      allow="encrypted-media"
      title="网易云音乐"
      loading="lazy"
    ></iframe>
  </div>
</div>

<script>
(function () {
  'use strict';

  var DEFAULT_ID = '3778678';
  var DEFAULT_NAME = '热歌榜';

  var settingsBtn = document.getElementById('music-settings-btn');
  var settingsEl = document.getElementById('music-settings');
  var playlistInput = document.getElementById('music-playlist-input');
  var saveBtn = document.getElementById('music-save-btn');
  var iframe = document.getElementById('music-iframe');
  var nameEl = document.getElementById('music-name-text');
  var pickBtns = document.querySelectorAll('.music-pick');

  if (!settingsBtn || !settingsEl || !playlistInput || !saveBtn || !iframe || !nameEl) {
    throw new Error('NetEaseMusic: missing DOM elements');
  }

  /* ---------- Playlist presets ---------- */
  var PRESETS = {
    '3778678': '🔥 热歌榜',
    '3779629': '✨ 新歌榜',
  };

  // Auto-rotate: switch between playlists every 3 days
  var ROTATION_PLAYLISTS = [
    { id: '3778678', name: '🔥 热歌榜' },
    { id: '3779629', name: '✨ 新歌榜' },
  ];

  /* ---------- localStorage helpers ---------- */
  function getPlaylistId() {
    try { return localStorage.getItem('netease-playlist-id') || DEFAULT_ID; }
    catch { return DEFAULT_ID; }
  }

  function getPlaylistName() {
    try { return localStorage.getItem('netease-playlist-name') || DEFAULT_NAME; }
    catch { return DEFAULT_NAME; }
  }

  function setPlaylistData(id, name) {
    try {
      localStorage.setItem('netease-playlist-id', id);
      localStorage.setItem('netease-playlist-name', name);
    } catch { /* skip */ }
  }

  /* ---------- iframe control ---------- */
  function buildIframeUrl(playlistId) {
    return 'https://music.163.com/outchain/player?type=0&id=' + encodeURIComponent(playlistId) + '&auto=1&height=430';
  }

  function loadPlayer(playlistId, playlistName) {
    iframe.src = buildIframeUrl(playlistId);
    nameEl.textContent = '🎶 ' + (playlistName || '歌单 ' + playlistId);
    setPlaylistData(playlistId, playlistName || '');
  }

  /* ---------- Highlight active playlist button ---------- */
  function highlightPick(playlistId) {
    pickBtns.forEach(function (btn) {
      var pid = btn.getAttribute('data-pid');
      if (pid === playlistId) {
        btn.classList.remove('bg-gray-100', 'dark:bg-gray-800', 'text-gray-600', 'dark:text-gray-300');
        btn.classList.add('bg-red-100', 'dark:bg-red-900/30', 'text-red-600', 'dark:text-red-400', 'font-medium');
      } else {
        btn.classList.remove('bg-red-100', 'dark:bg-red-900/30', 'text-red-600', 'dark:text-red-400', 'font-medium');
        btn.classList.add('bg-gray-100', 'dark:bg-gray-800', 'text-gray-600', 'dark:text-gray-300');
      }
    });
  }

  /* ---------- Init (with 3-day auto-rotation) ---------- */
  function getRotationIndex() {
    var start = new Date('2025-01-01').getTime();
    var now = Date.now();
    var daysSinceStart = Math.floor((now - start) / (1000 * 60 * 60 * 24));
    return Math.floor(daysSinceStart / 3) % ROTATION_PLAYLISTS.length;
  }

  var rotationIdx = getRotationIndex();
  var rotationPick = ROTATION_PLAYLISTS[rotationIdx];
  var savedId = getPlaylistId();
  var savedName = getPlaylistName();
  // Auto-rotate if currently on one of the rotation playlists
  var isRotationPlaylist = ROTATION_PLAYLISTS.some(function (p) { return p.id === savedId; });
  if (isRotationPlaylist && savedId !== rotationPick.id) {
    savedId = rotationPick.id;
    savedName = rotationPick.name;
    setPlaylistData(savedId, savedName);
  }
  playlistInput.value = savedId;
  nameEl.textContent = '🎶 ' + savedName;
  highlightPick(savedId);

  // Lazy-load iframe via IntersectionObserver
  var iframeLoaded = false;
  if ('IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function (entries) {
      for (var i = 0; i < entries.length; i++) {
        if (entries[i].isIntersecting && !iframeLoaded) {
          iframeLoaded = true;
          observer.disconnect();
          loadPlayer(savedId, savedName);
        }
      }
    }, { rootMargin: '200px' });
    observer.observe(iframe);

    setTimeout(function () {
      if (!iframeLoaded) {
        iframeLoaded = true;
        if (observer) observer.disconnect();
        loadPlayer(savedId, savedName);
      }
    }, 3000);
  } else {
    loadPlayer(savedId, savedName);
  }

  /* ---------- Settings toggle ---------- */
  settingsBtn.addEventListener('click', function () {
    var isOpen = !settingsEl.classList.contains('hidden');
    settingsEl.classList.toggle('hidden');
    if (!isOpen) playlistInput.focus();
  });

  /* ---------- Save custom playlist ---------- */
  function doSave() {
    var newId = playlistInput.value.trim();
    if (!newId) return;
    var newName = PRESETS[newId] || '歌单 ' + newId;
    highlightPick(newId);
    loadPlayer(newId, newName);
    settingsEl.classList.add('hidden');
  }

  saveBtn.addEventListener('click', doSave);
  playlistInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') doSave();
  });

  /* ---------- Quick-select playlist buttons ---------- */
  pickBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var pid = this.getAttribute('data-pid');
      var name = PRESETS[pid] || '歌单 ' + pid;
      highlightPick(pid);
      loadPlayer(pid, name);
      settingsEl.classList.add('hidden');
    });
  });

})();
</script>
