---
const defaultPlaylistId = '37i9dQZF1DXcBWIGoYBM5M';
---

<div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 overflow-hidden shadow-sm">
  <!-- Toggle header -->
  <button
    id="spotify-toggle"
    class="w-full bg-gradient-to-r from-green-600 to-emerald-600 px-4 py-3 flex items-center justify-between cursor-pointer hover:from-green-500 hover:to-emerald-500 transition-all text-left"
    aria-expanded="true"
    aria-controls="spotify-body"
  >
    <div class="flex items-center gap-2 min-w-0">
      <span class="text-xl leading-none flex-shrink-0" aria-hidden="true">🎧</span>
      <h2 class="text-sm font-bold text-white truncate">Spotify 播放器</h2>
    </div>
    <div class="flex items-center gap-2 flex-shrink-0">
      <button
        id="spotify-settings-btn"
        class="text-xs px-2 py-1 rounded bg-white/15 text-white hover:bg-white/25 transition-colors"
        title="设置歌单"
      >⚙️</button>
      <span id="spotify-chevron" class="text-white/80 text-lg transition-transform duration-200 rotate-90">▶</span>
    </div>
  </button>

  <!-- Body -->
  <div id="spotify-body">
    <div class="p-4">
      <!-- Settings (hidden by default) -->
      <div id="spotify-settings" class="hidden mb-3">
        <label class="text-xs text-gray-500 dark:text-gray-400 block mb-1">歌单 ID:</label>
        <div class="flex gap-1">
          <input
            id="spotify-playlist-input"
            type="text"
            class="flex-1 px-2 py-1 text-xs rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-1 focus:ring-green-500"
            placeholder="Playlist ID..."
            value={defaultPlaylistId}
          />
          <button
            id="spotify-save-btn"
            class="px-2 py-1 text-xs rounded bg-green-600 text-white hover:bg-green-700 transition-colors"
          >保存</button>
        </div>
      </div>

      <!-- Spotify iframe embed -->
      <div class="relative" style="padding-bottom: 80%">
        <iframe
          id="spotify-iframe"
          src=""
          style="position:absolute;top:0;left:0;width:100%;height:100%"
          frameborder="0"
          allowtransparency="true"
          allow="encrypted-media"
          title="Spotify"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  'use strict';

  var defaultPlaylistId = '37i9dQZF1DXcBWIGoYBM5M';

  var toggle = document.getElementById('spotify-toggle');
  var body = document.getElementById('spotify-body');
  var chevron = document.getElementById('spotify-chevron');
  var settingsBtn = document.getElementById('spotify-settings-btn');
  var settingsEl = document.getElementById('spotify-settings');
  var iframe = document.getElementById('spotify-iframe');
  var playlistInput = document.getElementById('spotify-playlist-input');
  var saveBtn = document.getElementById('spotify-save-btn');

  if (!toggle || !body || !chevron || !settingsBtn || !settingsEl || !iframe || !playlistInput || !saveBtn) {
    throw new Error('SpotifyPlayer: missing DOM elements');
  }

  var isSettingsOpen = false;

  /* ---------- localStorage helpers ---------- */
  function getPlaylistId() {
    try {
      return localStorage.getItem('spotify-playlist-id') || defaultPlaylistId;
    } catch {
      return defaultPlaylistId;
    }
  }

  function setPlaylistId(id) {
    try {
      localStorage.setItem('spotify-playlist-id', id);
    } catch { /* localStorage unavailable */ }
  }

  /* ---------- iframe control ---------- */
  function buildIframeUrl(playlistId) {
    return 'https://open.spotify.com/embed/playlist/' + encodeURIComponent(playlistId) + '?utm_source=generator&theme=0';
  }

  function loadIframe(playlistId) {
    iframe.src = buildIframeUrl(playlistId);
  }

  function unloadIframe() {
    iframe.src = '';
  }

  /* ---------- collapsible toggle ---------- */
  toggle.addEventListener('click', function (e) {
    if (e.target && (e.target.id === 'spotify-settings-btn' || e.target.closest('#spotify-settings-btn'))) return;
    var isOpen = !body.classList.contains('hidden');
    body.classList.toggle('hidden');
    chevron.style.transform = isOpen ? '' : 'rotate(90deg)';
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  /* ---------- settings toggle ---------- */
  settingsBtn.addEventListener('click', function (e) {
    e.stopPropagation();
    if (isSettingsOpen) {
      settingsEl.classList.add('hidden');
      isSettingsOpen = false;
    } else {
      playlistInput.value = getPlaylistId();
      settingsEl.classList.remove('hidden');
      isSettingsOpen = true;
      playlistInput.focus();
    }
  });

  /* ---------- save playlist ID ---------- */
  saveBtn.addEventListener('click', function (e) {
    e.stopPropagation();
    var newId = playlistInput.value.trim();
    if (newId) {
      setPlaylistId(newId);
      unloadIframe();
      setTimeout(function () { loadIframe(newId); }, 100);
    }
    settingsEl.classList.add('hidden');
    isSettingsOpen = false;
  });

  playlistInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') {
      e.stopPropagation();
      saveBtn.click();
    }
  });

  /* ---------- initial load ---------- */
  var playlistId = getPlaylistId();
  playlistInput.value = playlistId;
  loadIframe(playlistId);
})();
</script>
