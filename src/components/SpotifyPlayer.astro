---
const defaultPlaylistId = '37i9dQZF1DXcBWIGoYBM5M';
---

<div id="spotify-player" class="fixed top-20 right-4 z-50">
  <!-- Round toggle button (same pattern as MusicPlayer) -->
  <button
    id="spotify-toggle"
    class="w-10 h-10 rounded-full bg-white dark:bg-gray-800 shadow-lg border border-gray-200 dark:border-gray-700 flex items-center justify-center hover:shadow-xl transition-all hover:scale-105"
    title="Spotify Player"
    aria-label="打开 Spotify 播放器"
  >
    <span id="spotify-icon" class="text-lg">🎵</span>
  </button>

  <!-- Expanded panel (hidden by default) -->
  <div id="spotify-panel" class="hidden mt-2">
    <div
      class="relative bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 p-3"
      style="width: 300px;"
    >
      <!-- Close button -->
      <button
        id="spotify-close"
        class="absolute -top-2 -right-2 w-5 h-5 rounded-full bg-gray-700 text-white text-xs flex items-center justify-center hover:bg-gray-600 transition-colors"
        aria-label="关闭 Spotify"
      >
        ✕
      </button>

      <!-- Header row: title + settings gear -->
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-medium text-gray-800 dark:text-gray-200">🎧 Spotify</span>
        <button
          id="spotify-settings-btn"
          class="w-6 h-6 rounded-full bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-300 flex items-center justify-center hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors text-sm"
          aria-label="设置歌单"
          title="设置歌单 ID"
        >
          ⚙️
        </button>
      </div>

      <!-- Settings panel (hidden by default) -->
      <div id="spotify-settings" class="hidden mb-2">
        <label class="text-xs text-gray-500 dark:text-gray-400 block mb-1">歌单 ID:</label>
        <div class="flex gap-1">
          <input
            id="spotify-playlist-input"
            type="text"
            class="flex-1 px-2 py-1 text-xs rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-1 focus:ring-blue-500"
            placeholder="Playlist ID..."
            value={defaultPlaylistId}
          />
          <button
            id="spotify-save-btn"
            class="px-2 py-1 text-xs rounded bg-blue-600 text-white hover:bg-blue-700 transition-colors"
          >
            保存
          </button>
        </div>
      </div>

      <!-- Spotify iframe embed -->
      <iframe
        id="spotify-iframe"
        src=""
        width="300"
        height="380"
        frameborder="0"
        allowtransparency="true"
        allow="encrypted-media"
        title="Spotify"
        loading="lazy"
      ></iframe>
    </div>
  </div>
</div>

<script>
  const defaultPlaylistId = '37i9dQZF1DXcBWIGoYBM5M';

  const toggle = document.getElementById('spotify-toggle');
  const panel = document.getElementById('spotify-panel');
  const closeBtn = document.getElementById('spotify-close');
  const iframe = document.getElementById('spotify-iframe');
  const settingsBtn = document.getElementById('spotify-settings-btn');
  const settingsEl = document.getElementById('spotify-settings');
  const playlistInput = document.getElementById('spotify-playlist-input');
  const saveBtn = document.getElementById('spotify-save-btn');
  const spotifyIcon = document.getElementById('spotify-icon');
  let isOpen = false;
  let isSettingsOpen = false;

  /* ---------- localStorage helpers (guarded with try/catch) ---------- */
  function getPlaylistId() {
    try {
      return localStorage.getItem('spotify-playlist-id') || defaultPlaylistId;
    } catch {
      return defaultPlaylistId;
    }
  }

  function setPlaylistId(id) {
    try {
      localStorage.setItem('spotify-playlist-id', id);
    } catch {
      // localStorage unavailable (private browsing, etc.)
    }
  }

  /* ---------- iframe control ---------- */
  function buildIframeUrl(playlistId) {
    return 'https://open.spotify.com/embed/playlist/' + playlistId + '?utm_source=generator&theme=0';
  }

  function loadIframe(playlistId) {
    iframe.src = buildIframeUrl(playlistId);
  }

  function unloadIframe() {
    // Setting src to empty stops the iframe from loading / playing
    iframe.src = '';
  }

  /* ---------- open / close ---------- */
  function openPlayer() {
    const playlistId = getPlaylistId();
    playlistInput.value = playlistId;
    loadIframe(playlistId);
    panel.classList.remove('hidden');
    spotifyIcon.textContent = '🎶';
    isOpen = true;
  }

  function closePlayer() {
    panel.classList.add('hidden');
    unloadIframe();
    spotifyIcon.textContent = '🎵';
    isOpen = false;
    // Also close settings sub-panel if it was open
    if (isSettingsOpen) {
      settingsEl.classList.add('hidden');
      isSettingsOpen = false;
    }
  }

  /* ---------- event listeners ---------- */
  toggle.addEventListener('click', function () {
    if (isOpen) {
      closePlayer();
    } else {
      openPlayer();
    }
  });

  closeBtn.addEventListener('click', function (e) {
    e.stopPropagation();
    closePlayer();
  });

  settingsBtn.addEventListener('click', function (e) {
    e.stopPropagation();
    if (isSettingsOpen) {
      settingsEl.classList.add('hidden');
      isSettingsOpen = false;
    } else {
      const playlistId = getPlaylistId();
      playlistInput.value = playlistId;
      settingsEl.classList.remove('hidden');
      isSettingsOpen = true;
      playlistInput.focus();
    }
  });

  saveBtn.addEventListener('click', function (e) {
    e.stopPropagation();
    var newId = playlistInput.value.trim();
    if (newId) {
      setPlaylistId(newId);
      // Unload then reload with new playlist ID
      unloadIframe();
      setTimeout(function () {
        loadIframe(newId);
      }, 100);
    }
    settingsEl.classList.add('hidden');
    isSettingsOpen = false;
  });

  playlistInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') {
      e.stopPropagation();
      saveBtn.click();
    }
  });
</script>
