---
// StockMarket - real-time stock market indices tracker via Yahoo Finance API
// Uses client-side fetch with sessionStorage cache (60s TTL)
// Falls back to CORS proxy if direct fetch fails
---

<div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 overflow-hidden shadow-sm">
  <!-- Toggle header -->
  <button
    id="stock-toggle"
    class="w-full bg-gradient-to-r from-green-600 to-emerald-600 px-4 py-3 flex items-center justify-between cursor-pointer hover:from-green-500 hover:to-emerald-500 transition-all text-left"
    aria-expanded="true"
    aria-controls="stock-body"
  >
    <div class="flex items-center gap-2 min-w-0">
      <span class="text-xl leading-none flex-shrink-0" aria-hidden="true">📈</span>
      <h2 class="text-sm font-bold text-white truncate">全球股指</h2>
      <span id="stock-last-update" class="text-xs text-white/60 truncate"></span>
    </div>
    <div class="flex items-center gap-2 flex-shrink-0">
      <button
        id="stock-refresh"
        class="text-xs px-2 py-1 rounded bg-white/15 text-white hover:bg-white/25 transition-colors"
        title="刷新数据"
      >🔄</button>
      <span id="stock-chevron" class="text-white/80 text-lg transition-transform duration-200 rotate-90">▶</span>
    </div>
  </button>

  <!-- Body (expanded by default) -->
  <div id="stock-body">
    <div class="p-4" id="stock-content">
      <!-- Loading state -->
      <div id="stock-loading" class="space-y-3">
        <div class="flex items-center gap-3 py-2 animate-pulse">
          <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-20"></div>
          <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-16 ml-auto"></div>
          <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-12"></div>
        </div>
        <div class="flex items-center gap-3 py-2 animate-pulse">
          <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-24"></div>
          <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-14 ml-auto"></div>
          <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-10"></div>
        </div>
        <div class="flex items-center gap-3 py-2 animate-pulse">
          <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-16"></div>
          <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-12 ml-auto"></div>
          <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-14"></div>
        </div>
      </div>

      <!-- Error state (hidden by default) -->
      <div id="stock-error" class="text-center py-6 hidden">
        <span class="text-3xl" aria-hidden="true">⚠️</span>
        <p class="text-sm text-red-500 dark:text-red-400 mt-2">行情数据加载失败</p>
        <button
          id="stock-retry"
          class="mt-3 text-xs px-3 py-1.5 rounded-lg bg-green-600 text-white hover:bg-green-700 transition-colors"
        >
          重试
        </button>
      </div>

      <!-- Search -->
      <div id="stock-search-area" class="mt-1 mb-3">
        <div class="relative">
          <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm">🔍</span>
          <input
            type="text"
            id="stock-search-input"
            class="w-full pl-8 pr-3 py-2 text-xs rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-800 dark:text-gray-200 placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-green-500 focus:border-green-500 transition-shadow"
            placeholder="搜索个股 (代码/名称/中文)..."
            autocomplete="off"
          />
        </div>
        <!-- Search results dropdown -->
        <div id="stock-search-results" class="hidden mt-1 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 divide-y divide-gray-100 dark:divide-gray-800 overflow-hidden shadow-lg"></div>
        <!-- Single stock result card -->
        <div id="stock-single-result" class="hidden mt-2"></div>
      </div>

      <!-- Market groups (filled by JS) -->
      <div id="stock-groups" class="hidden space-y-4"></div>
    </div>
  </div>
</div>

<script>
(function() {
  'use strict';

  var CACHE_KEY = 'stock-market-cache';
  var CACHE_TTL = 60 * 1000; // 60 seconds

  var INDICES = [
    { symbol: '000001.SS', name: '上证指数', market: 'A股' },
    { symbol: '399001.SZ', name: '深证成指', market: 'A股' },
    { symbol: '^HSI', name: '恒生指数', market: '港股' },
    { symbol: '^N225', name: '日经225', market: '日股' },
    { symbol: '^IXIC', name: '纳斯达克', market: '美股' },
    { symbol: '^DJI', name: '道琼斯', market: '美股' },
    { symbol: '^GSPC', name: '标普500', market: '美股' },
  ];

  // Market order for display
  var MARKET_ORDER = ['A股', '港股', '日股', '美股'];
  var MARKET_LABELS = {
    'A股': '🇨🇳 A股',
    '港股': '🇭🇰 港股',
    '日股': '🇯🇵 日股',
    '美股': '🇺🇸 美股',
  };

  // DOM refs
  var toggleEl = document.getElementById('stock-toggle');
  var bodyEl = document.getElementById('stock-body');
  var chevronEl = document.getElementById('stock-chevron');
  var refreshEl = document.getElementById('stock-refresh');
  var loadingEl = document.getElementById('stock-loading');
  var errorEl = document.getElementById('stock-error');
  var retryEl = document.getElementById('stock-retry');
  var groupsEl = document.getElementById('stock-groups');
  var lastUpdateEl = document.getElementById('stock-last-update');

  if (!toggleEl || !bodyEl || !chevronEl || !refreshEl || !loadingEl || !errorEl || !retryEl || !groupsEl || !lastUpdateEl) {
    throw new Error('StockMarket: missing DOM elements');
  }

  /**
   * Format a number with comma separators and fixed decimals
   */
  function fmtPrice(num) {
    if (num == null || isNaN(num)) return '--';
    return num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  /**
   * Format change value: show sign and value
   */
  function fmtChange(num) {
    if (num == null || isNaN(num)) return '--';
    var sign = num > 0 ? '+' : '';
    return sign + num.toFixed(2);
  }

  /**
   * Format change percent
   */
  function fmtChangePct(num) {
    if (num == null || isNaN(num)) return '--';
    var sign = num > 0 ? '+' : '';
    return sign + num.toFixed(2) + '%';
  }

  /**
   * Get color class based on change value
   * Chinese convention: red for up (涨), green for down (跌)
   */
  function changeColor(num) {
    if (num == null || isNaN(num)) return 'text-gray-400 dark:text-gray-500';
    if (num > 0) return 'text-red-500 dark:text-red-400';   // 涨 → red
    if (num < 0) return 'text-green-600 dark:text-green-400'; // 跌 → green
    return 'text-gray-500 dark:text-gray-400';
  }

  /**
   * Fetch all stock data via server-side proxy (no CORS issues)
   */
  async function fetchAllStocks() {
    var symbols = INDICES.map(function(item) { return item.symbol; }).join(',');
    var res = await fetch('/api/stock?symbols=' + encodeURIComponent(symbols), {
      headers: { 'Accept': 'application/json' }
    });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    return await res.json();
  }

  /**
   * Check cache in sessionStorage
   */
  function getCache() {
    try {
      var cached = sessionStorage.getItem(CACHE_KEY);
      if (cached) {
        var parsed = JSON.parse(cached);
        if (parsed && parsed.timestamp && parsed.data && Date.now() - parsed.timestamp < CACHE_TTL) {
          return parsed.data;
        }
      }
    } catch (_) {}
    return null;
  }

  /**
   * Set cache in sessionStorage
   */
  function setCache(data) {
    try {
      sessionStorage.setItem(CACHE_KEY, JSON.stringify({ timestamp: Date.now(), data: data }));
    } catch (_) {}
  }

  /**
   * Load all stock indices, with caching
   */
  async function loadAllStocks() {
    // Check cache first
    var cached = getCache();
    if (cached) {
      return cached;
    }

    var results;
    try {
      results = await fetchAllStocks();
    } catch (err) {
      console.error('Stock fetch error:', err);
      throw err;
    }

    if (!results || results.length === 0) {
      throw new Error('No data returned');
    }

    // Add market info to each result
    var marketMap = {};
    INDICES.forEach(function(item) {
      marketMap[item.symbol] = item.market;
    });
    results.forEach(function(r) {
      r.market = marketMap[r.symbol] || '';
    });

    // Cache results
    setCache(results);

    return results;
  }

  /**
   * Render market groups into DOM
   */
  function render(data) {
    // Group by market
    var groups = {};
    data.forEach(function(item) {
      var market = item.market || '其他';
      if (!groups[market]) groups[market] = [];
      groups[market].push(item);
    });

    // Build HTML in market order
    var html = '';
    var now = new Date();

    MARKET_ORDER.forEach(function(market) {
      var items = groups[market];
      if (!items || items.length === 0) return;

      html += '<div class="stock-market-group">';
      html += '<h4 class="text-xs font-semibold text-gray-500 dark:text-gray-400 mb-2 uppercase tracking-wider">' + (MARKET_LABELS[market] || market) + '</h4>';
      html += '<div class="divide-y divide-gray-100 dark:divide-gray-800 rounded-lg border border-gray-100 dark:border-gray-800 overflow-hidden">';

      items.forEach(function(item) {
        var colorClass = changeColor(item.change);

        html += '<div class="flex items-center gap-2 px-3 py-2.5 hover:bg-gray-50 dark:hover:bg-gray-800/30 transition-colors">';

        // Name
        html += '<div class="flex-1 min-w-0">';
        html += '<span class="text-xs font-medium text-gray-700 dark:text-gray-300 truncate block">' + escapeHtml(item.name) + '</span>';
        if (item.currency) {
          html += '<span class="text-[10px] text-gray-400 dark:text-gray-500">' + escapeHtml(item.currency) + '</span>';
        }
        html += '</div>';

        // Price or error
        if (item.currentPrice != null) {
          html += '<span class="text-xs font-bold text-gray-800 dark:text-gray-200 tabular-nums">' + fmtPrice(item.currentPrice) + '</span>';
          html += '<span class="text-xs font-mono tabular-nums ' + colorClass + ' w-[70px] text-right flex-shrink-0">' + fmtChange(item.change) + '</span>';
          html += '<span class="text-xs font-mono tabular-nums ' + colorClass + ' w-[70px] text-right flex-shrink-0">' + fmtChangePct(item.changePct) + '</span>';
        } else {
          html += '<span class="text-xs text-gray-400 dark:text-gray-500">' + (item.error || '暂无数据') + '</span>';
        }

        html += '</div>';
      });

      html += '</div></div>';
    });

    groupsEl.innerHTML = html;
    groupsEl.classList.remove('hidden');

    // Update last fetch time
    lastUpdateEl.textContent = '🕐 ' + now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');
    lastUpdateEl.classList.remove('hidden');
  }

  /**
   * Minimal HTML escape
   */
  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  /**
   * Main init: load data and render
   */
  async function init() {
    loadingEl.classList.remove('hidden');
    errorEl.classList.add('hidden');
    groupsEl.classList.add('hidden');

    try {
      var data = await loadAllStocks();
      render(data);
      loadingEl.classList.add('hidden');
    } catch (err) {
      console.error('StockMarket error:', err);
      loadingEl.classList.add('hidden');
      errorEl.classList.remove('hidden');
    }
  }

  // --- Event handlers ---

  // Collapsible toggle
  toggleEl.addEventListener('click', function(e) {
    // Don't toggle if refresh button was clicked
    if (e.target && (e.target.id === 'stock-refresh' || e.target.closest('#stock-refresh'))) return;

    var isOpen = !bodyEl.classList.contains('hidden');
    bodyEl.classList.toggle('hidden');
    chevronEl.style.transform = isOpen ? '' : 'rotate(90deg)';
    toggleEl.setAttribute('aria-expanded', String(!isOpen));
  });

  // Refresh button
  refreshEl.addEventListener('click', function(e) {
    e.stopPropagation();
    init();
  });

  // Retry button (in error state)
  retryEl.addEventListener('click', function() {
    init();
  });

  // --- Search functionality ---

  var searchInput = document.getElementById('stock-search-input');
  var searchResults = document.getElementById('stock-search-results');
  var singleResult = document.getElementById('stock-single-result');
  var searchTimer = null;

  /**
   * Search stocks via Yahoo Finance search API
   */
  async function searchStocks(query) {
    var res = await fetch('/api/stock?search=' + encodeURIComponent(query), {
      headers: { 'Accept': 'application/json' }
    });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    return await res.json();
  }

  /**
   * Fetch a single stock quote data
   */
  async function fetchSingleStock(symbol) {
    var res = await fetch('/api/stock?symbols=' + encodeURIComponent(symbol), {
      headers: { 'Accept': 'application/json' }
    });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    var data = await res.json();
    return data && data.length > 0 ? data[0] : null;
  }

  /**
   * Render search results dropdown
   */
  function renderSearchResults(data) {
    if (!data.quotes || data.quotes.length === 0) {
      searchResults.innerHTML = '<div class="px-3 py-3 text-xs text-gray-400 text-center">未找到匹配结果</div>';
      searchResults.classList.remove('hidden');
      return;
    }

    var html = '';
    data.quotes.forEach(function(q) {
      var typeIcon = q.quoteType === 'EQUITY' ? '🏢' : q.quoteType === 'ETF' ? '📦' : q.quoteType === 'INDEX' ? '📊' : '💹';
      html += '<button class="stock-search-item w-full flex items-center gap-3 px-3 py-2.5 text-left hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors cursor-pointer" data-symbol="' + escapeHtml(q.symbol) + '">';
      html += '<span class="text-sm">' + typeIcon + '</span>';
      html += '<div class="flex-1 min-w-0">';
      html += '<span class="text-xs font-medium text-gray-800 dark:text-gray-200 block truncate">' + escapeHtml(q.name) + '</span>';
      html += '<span class="text-[10px] text-gray-400">' + escapeHtml(q.symbol) + (q.exchange ? ' · ' + escapeHtml(q.exchange) : '') + '</span>';
      html += '</div>';
      html += '<span class="text-[10px] text-gray-400 bg-gray-100 dark:bg-gray-700 px-1.5 py-0.5 rounded">' + escapeHtml(q.quoteType || '') + '</span>';
      html += '</button>';
    });

    searchResults.innerHTML = html;
    searchResults.classList.remove('hidden');

    // Attach click handlers to each result item
    searchResults.querySelectorAll('.stock-search-item').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var symbol = this.getAttribute('data-symbol');
        var name = this.querySelector('.text-xs.font-medium')?.textContent || symbol;
        selectStock(symbol, name);
      });
    });
  }

  /**
   * User selected a stock from search results
   */
  async function selectStock(symbol, name) {
    // Hide search results
    searchResults.classList.add('hidden');
    searchInput.value = name + ' (' + symbol + ')';

    // Show loading
    singleResult.innerHTML = '<div class="flex items-center gap-3 py-3 animate-pulse"><div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-24"></div><div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-16 ml-auto"></div></div>';
    singleResult.classList.remove('hidden');

    try {
      var data = await fetchSingleStock(symbol);
      if (!data) throw new Error('No data');

      if (data.error) {
        singleResult.innerHTML = '<div class="text-center py-4"><span class="text-xs text-red-400">⚠️ ' + escapeHtml(data.error) + '</span></div>';
        return;
      }

      // Render result card (similar style to index items)
      var colorClass = changeColor(data.change);
      var arrow = data.change > 0 ? '▲' : (data.change < 0 ? '▼' : '—');
      var isUp = data.change > 0;

      singleResult.innerHTML =
        '<div class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 overflow-hidden">' +
        '<div class="flex items-center gap-3 px-3 py-3">' +
        '<div class="flex-1 min-w-0">' +
        '<span class="text-sm font-semibold text-gray-800 dark:text-gray-200 block truncate">' + escapeHtml(data.name || symbol) + '</span>' +
        '<span class="text-[11px] text-gray-400">' + escapeHtml(symbol) + (data.currency ? ' · ' + escapeHtml(data.currency) : '') + '</span>' +
        '</div>' +
        '<div class="text-right">' +
        '<div class="text-lg font-bold tabular-nums ' + colorClass + '">' + fmtPrice(data.currentPrice) + '</div>' +
        '<div class="text-xs font-mono tabular-nums ' + colorClass + '">' + arrow + ' ' + fmtChange(data.change) + ' · ' + fmtChangePct(data.changePct) + '</div>' +
        '</div>' +
        '</div>' +
        '</div>';
    } catch (err) {
      singleResult.innerHTML = '<div class="text-center py-4"><span class="text-xs text-red-400">⚠️ 加载失败: ' + escapeHtml(err.message) + '</span></div>';
    }
  }

  // IME composition state (Chinese input method)
  var isComposing = false;

  searchInput.addEventListener('compositionstart', function() {
    isComposing = true;
  });

  searchInput.addEventListener('compositionend', function() {
    isComposing = false;
    // Trigger search after composition ends
    triggerSearch();
  });

  // Debounced search on input
  searchInput.addEventListener('input', function() {
    // Skip while IME composition is in progress (e.g., typing pinyin)
    if (isComposing) return;
    triggerSearch();
  });

  function triggerSearch() {
    var query = searchInput.value.trim();
    if (query.length < 1) {
      searchResults.classList.add('hidden');
      singleResult.classList.add('hidden');
      return;
    }

    // Clear previous timer
    if (searchTimer) clearTimeout(searchTimer);

    searchTimer = setTimeout(function() {
      (async function() {
        try {
          var data = await searchStocks(query);
          renderSearchResults(data);
        } catch (err) {
          searchResults.innerHTML = '<div class="px-3 py-3 text-xs text-red-400 text-center">搜索失败: ' + escapeHtml(err.message) + '</div>';
          searchResults.classList.remove('hidden');
        }
      })();
    }, 300);
  }

  // Close search results on blur (with delay to allow click)
  searchInput.addEventListener('blur', function() {
    setTimeout(function() {
      searchResults.classList.add('hidden');
    }, 200);
  });

  // Focus back to show results if input has value
  searchInput.addEventListener('focus', function() {
    if (this.value.trim().length >= 1 && !searchResults.classList.contains('hidden')) {
      searchResults.classList.remove('hidden');
    }
  });

  // Keyboard: Enter on search input triggers search
  searchInput.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !isComposing) {
      var query = this.value.trim();
      if (query.length < 1) return;
      // If there are visible results, click the first one
      var firstItem = searchResults.querySelector('.stock-search-item');
      if (firstItem) {
        firstItem.click();
      } else {
        // Otherwise search directly
        if (searchTimer) clearTimeout(searchTimer);
        (async function() {
          try {
            var data = await searchStocks(query);
            renderSearchResults(data);
          } catch (err) {
            searchResults.innerHTML = '<div class="px-3 py-3 text-xs text-red-400 text-center">搜索失败</div>';
            searchResults.classList.remove('hidden');
          }
        })();
      }
    }
  });

  // Handle body click to close search results when clicking outside
  document.addEventListener('click', function(e) {
    var area = document.getElementById('stock-search-area');
    if (area && !area.contains(e.target)) {
      searchResults.classList.add('hidden');
    }
  });

  // Initial load
  init();
})();
</script>
