---
// StockMarket - real-time stock market indices tracker via Yahoo Finance API
// Uses client-side fetch with sessionStorage cache (60s TTL)
// Falls back to CORS proxy if direct fetch fails
---

<div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 overflow-hidden shadow-sm">
  <!-- Toggle header -->
  <button
    id="stock-toggle"
    class="w-full bg-gradient-to-r from-green-600 to-emerald-600 px-4 py-3 flex items-center justify-between cursor-pointer hover:from-green-500 hover:to-emerald-500 transition-all text-left"
    aria-expanded="true"
    aria-controls="stock-body"
  >
    <div class="flex items-center gap-2 min-w-0">
      <span class="text-xl leading-none flex-shrink-0" aria-hidden="true">📈</span>
      <h2 class="text-sm font-bold text-white truncate">全球股指</h2>
      <span id="stock-last-update" class="text-xs text-white/60 truncate"></span>
    </div>
    <div class="flex items-center gap-2 flex-shrink-0">
      <button
        id="stock-refresh"
        class="text-xs px-2 py-1 rounded bg-white/15 text-white hover:bg-white/25 transition-colors"
        title="刷新数据"
      >🔄</button>
      <span id="stock-chevron" class="text-white/80 text-lg transition-transform duration-200 rotate-90">▶</span>
    </div>
  </button>

  <!-- Body (expanded by default) -->
  <div id="stock-body">
    <div class="p-4" id="stock-content">
      <!-- Loading state -->
      <div id="stock-loading" class="space-y-3">
        <div class="flex items-center gap-3 py-2 animate-pulse">
          <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-20"></div>
          <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-16 ml-auto"></div>
          <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-12"></div>
        </div>
        <div class="flex items-center gap-3 py-2 animate-pulse">
          <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-24"></div>
          <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-14 ml-auto"></div>
          <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-10"></div>
        </div>
        <div class="flex items-center gap-3 py-2 animate-pulse">
          <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-16"></div>
          <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-12 ml-auto"></div>
          <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-14"></div>
        </div>
      </div>

      <!-- Error state (hidden by default) -->
      <div id="stock-error" class="text-center py-6 hidden">
        <span class="text-3xl" aria-hidden="true">⚠️</span>
        <p class="text-sm text-red-500 dark:text-red-400 mt-2">行情数据加载失败</p>
        <button
          id="stock-retry"
          class="mt-3 text-xs px-3 py-1.5 rounded-lg bg-green-600 text-white hover:bg-green-700 transition-colors"
        >
          重试
        </button>
      </div>

      <!-- Market groups (filled by JS) -->
      <div id="stock-groups" class="hidden space-y-4"></div>
    </div>
  </div>
</div>

<script>
(function() {
  'use strict';

  var CACHE_KEY = 'stock-market-cache';
  var CACHE_TTL = 60 * 1000; // 60 seconds

  var INDICES = [
    { symbol: '000001.SS', name: '上证指数', market: 'A股' },
    { symbol: '399001.SZ', name: '深证成指', market: 'A股' },
    { symbol: '^HSI', name: '恒生指数', market: '港股' },
    { symbol: '^N225', name: '日经225', market: '日股' },
    { symbol: '^IXIC', name: '纳斯达克', market: '美股' },
    { symbol: '^DJI', name: '道琼斯', market: '美股' },
    { symbol: '^GSPC', name: '标普500', market: '美股' },
  ];

  // Market order for display
  var MARKET_ORDER = ['A股', '港股', '日股', '美股'];
  var MARKET_LABELS = {
    'A股': '🇨🇳 A股',
    '港股': '🇭🇰 港股',
    '日股': '🇯🇵 日股',
    '美股': '🇺🇸 美股',
  };

  // DOM refs
  var toggleEl = document.getElementById('stock-toggle');
  var bodyEl = document.getElementById('stock-body');
  var chevronEl = document.getElementById('stock-chevron');
  var refreshEl = document.getElementById('stock-refresh');
  var loadingEl = document.getElementById('stock-loading');
  var errorEl = document.getElementById('stock-error');
  var retryEl = document.getElementById('stock-retry');
  var groupsEl = document.getElementById('stock-groups');
  var lastUpdateEl = document.getElementById('stock-last-update');

  if (!toggleEl || !bodyEl || !chevronEl || !refreshEl || !loadingEl || !errorEl || !retryEl || !groupsEl || !lastUpdateEl) {
    throw new Error('StockMarket: missing DOM elements');
  }

  /**
   * Format a number with comma separators and fixed decimals
   */
  function fmtPrice(num) {
    if (num == null || isNaN(num)) return '--';
    return num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  /**
   * Format change value: show sign and value
   */
  function fmtChange(num) {
    if (num == null || isNaN(num)) return '--';
    var sign = num > 0 ? '+' : '';
    return sign + num.toFixed(2);
  }

  /**
   * Format change percent
   */
  function fmtChangePct(num) {
    if (num == null || isNaN(num)) return '--';
    var sign = num > 0 ? '+' : '';
    return sign + num.toFixed(2) + '%';
  }

  /**
   * Get color class based on change value
   * Chinese convention: red for up (涨), green for down (跌)
   */
  function changeColor(num) {
    if (num == null || isNaN(num)) return 'text-gray-400 dark:text-gray-500';
    if (num > 0) return 'text-red-500 dark:text-red-400';   // 涨 → red
    if (num < 0) return 'text-green-600 dark:text-green-400'; // 跌 → green
    return 'text-gray-500 dark:text-gray-400';
  }

  /**
   * Fetch all stock data via server-side proxy (no CORS issues)
   */
  async function fetchAllStocks() {
    var symbols = INDICES.map(function(item) { return item.symbol; }).join(',');
    var res = await fetch('/api/stock?symbols=' + encodeURIComponent(symbols), {
      headers: { 'Accept': 'application/json' }
    });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    return await res.json();
  }

  /**
   * Check cache in sessionStorage
   */
  function getCache() {
    try {
      var cached = sessionStorage.getItem(CACHE_KEY);
      if (cached) {
        var parsed = JSON.parse(cached);
        if (parsed && parsed.timestamp && parsed.data && Date.now() - parsed.timestamp < CACHE_TTL) {
          return parsed.data;
        }
      }
    } catch (_) {}
    return null;
  }

  /**
   * Set cache in sessionStorage
   */
  function setCache(data) {
    try {
      sessionStorage.setItem(CACHE_KEY, JSON.stringify({ timestamp: Date.now(), data: data }));
    } catch (_) {}
  }

  /**
   * Load all stock indices, with caching
   */
  async function loadAllStocks() {
    // Check cache first
    var cached = getCache();
    if (cached) {
      return cached;
    }

    var results;
    try {
      results = await fetchAllStocks();
    } catch (err) {
      console.error('Stock fetch error:', err);
      throw err;
    }

    if (!results || results.length === 0) {
      throw new Error('No data returned');
    }

    // Add market info to each result
    var marketMap = {};
    INDICES.forEach(function(item) {
      marketMap[item.symbol] = item.market;
    });
    results.forEach(function(r) {
      r.market = marketMap[r.symbol] || '';
    });

    // Cache results
    setCache(results);

    return results;
  }

  /**
   * Render market groups into DOM
   */
  function render(data) {
    // Group by market
    var groups = {};
    data.forEach(function(item) {
      var market = item.market || '其他';
      if (!groups[market]) groups[market] = [];
      groups[market].push(item);
    });

    // Build HTML in market order
    var html = '';
    var now = new Date();

    MARKET_ORDER.forEach(function(market) {
      var items = groups[market];
      if (!items || items.length === 0) return;

      html += '<div class="stock-market-group">';
      html += '<h4 class="text-xs font-semibold text-gray-500 dark:text-gray-400 mb-2 uppercase tracking-wider">' + (MARKET_LABELS[market] || market) + '</h4>';
      html += '<div class="divide-y divide-gray-100 dark:divide-gray-800 rounded-lg border border-gray-100 dark:border-gray-800 overflow-hidden">';

      items.forEach(function(item) {
        var colorClass = changeColor(item.change);

        html += '<div class="flex items-center gap-2 px-3 py-2.5 hover:bg-gray-50 dark:hover:bg-gray-800/30 transition-colors">';

        // Name
        html += '<div class="flex-1 min-w-0">';
        html += '<span class="text-xs font-medium text-gray-700 dark:text-gray-300 truncate block">' + escapeHtml(item.name) + '</span>';
        if (item.currency) {
          html += '<span class="text-[10px] text-gray-400 dark:text-gray-500">' + escapeHtml(item.currency) + '</span>';
        }
        html += '</div>';

        // Price or error
        if (item.currentPrice != null) {
          html += '<span class="text-xs font-bold text-gray-800 dark:text-gray-200 tabular-nums">' + fmtPrice(item.currentPrice) + '</span>';
          html += '<span class="text-xs font-mono tabular-nums ' + colorClass + ' w-[70px] text-right flex-shrink-0">' + fmtChange(item.change) + '</span>';
          html += '<span class="text-xs font-mono tabular-nums ' + colorClass + ' w-[70px] text-right flex-shrink-0">' + fmtChangePct(item.changePct) + '</span>';
        } else {
          html += '<span class="text-xs text-gray-400 dark:text-gray-500">' + (item.error || '暂无数据') + '</span>';
        }

        html += '</div>';
      });

      html += '</div></div>';
    });

    groupsEl.innerHTML = html;
    groupsEl.classList.remove('hidden');

    // Update last fetch time
    lastUpdateEl.textContent = '🕐 ' + now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');
    lastUpdateEl.classList.remove('hidden');
  }

  /**
   * Minimal HTML escape
   */
  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  /**
   * Main init: load data and render
   */
  async function init() {
    loadingEl.classList.remove('hidden');
    errorEl.classList.add('hidden');
    groupsEl.classList.add('hidden');

    try {
      var data = await loadAllStocks();
      render(data);
      loadingEl.classList.add('hidden');
    } catch (err) {
      console.error('StockMarket error:', err);
      loadingEl.classList.add('hidden');
      errorEl.classList.remove('hidden');
    }
  }

  // --- Event handlers ---

  // Collapsible toggle
  toggleEl.addEventListener('click', function(e) {
    // Don't toggle if refresh button was clicked
    if (e.target && (e.target.id === 'stock-refresh' || e.target.closest('#stock-refresh'))) return;

    var isOpen = !bodyEl.classList.contains('hidden');
    bodyEl.classList.toggle('hidden');
    chevronEl.style.transform = isOpen ? '' : 'rotate(90deg)';
    toggleEl.setAttribute('aria-expanded', String(!isOpen));
  });

  // Refresh button
  refreshEl.addEventListener('click', function(e) {
    e.stopPropagation();
    init();
  });

  // Retry button (in error state)
  retryEl.addEventListener('click', function() {
    init();
  });

  // Initial load
  init();
})();
</script>
