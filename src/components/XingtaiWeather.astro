---
// XingtaiWeather — 邢台天气（单城市）
// Uses wttr.in free API (no API key required)
---

<div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 overflow-hidden shadow-sm">
  <div class="bg-gradient-to-r from-amber-500 to-orange-500 px-4 py-3">
    <h3 class="text-sm font-bold text-white flex items-center gap-2">
      <span aria-hidden="true">🌤️</span> 邢台天气
    </h3>
  </div>
  <div class="p-4" id="weather-widget">
    <div id="weather-loading" class="text-center text-gray-500 dark:text-gray-400 text-sm py-4">🌤️ 加载中...</div>
    <div id="weather-error" class="text-center text-red-500 text-sm py-4 hidden">❌ 天气加载失败</div>
    <div id="weather-content" class="hidden">
      <div class="text-center mb-4">
        <div class="text-4xl font-bold text-gray-800 dark:text-gray-200 tabular-nums" id="weather-temp">--</div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1" id="weather-desc">--</div>
        <div class="flex justify-center gap-4 mt-2 text-xs text-gray-500 dark:text-gray-400">
          <span id="weather-humidity">💧 --</span>
          <span id="weather-wind">💨 --</span>
        </div>
      </div>
      <details class="text-xs">
        <summary class="font-medium text-gray-600 dark:text-gray-300 cursor-pointer hover:text-gray-800 dark:hover:text-gray-100 list-none flex items-center gap-1 [&::-webkit-details-marker]:hidden">📅 未来3天预报</summary>
        <div class="mt-2 space-y-2" id="weather-forecast"></div>
      </details>
    </div>
  </div>
</div>

<script>
(function() {
  'use strict';
  var CACHE_KEY = 'xingtai-weather';
  var CACHE_TTL = 30 * 60 * 1000;
  var els = {};
  ['loading','error','content','temp','desc','humidity','wind','forecast'].forEach(function(k) {
    els[k] = document.getElementById('weather-' + k);
  });
  if (!els.loading) return;

  function emoji(c) {
    var n = Number(c);
    if (n === 113) return '☀️'; if (n === 116) return '⛅';
    if (n >= 119 && n <= 122) return '☁️'; if (n >= 176 && n <= 200) return '🌧️';
    if (n >= 227 && n <= 230) return '❄️'; return '🌤️';
  }
  function fmtDate(s) {
    var d = new Date(s + 'T00:00:00');
    if (isNaN(d.getTime())) return s;
    return (d.getMonth()+1)+'/'+d.getDate()+' '+['周日','周一','周二','周三','周四','周五','周六'][d.getDay()];
  }

  (async function() {
    try {
      var cached = JSON.parse(sessionStorage.getItem(CACHE_KEY) || '{}');
      if (cached && cached.ts && Date.now() - cached.ts < CACHE_TTL) { render(cached.data); return; }
      var res = await fetch('https://wttr.in/Xingtai?format=j1');
      if (!res.ok) throw new Error('HTTP ' + res.status);
      var data = await res.json();
      sessionStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), data: data }));
      render(data);
    } catch(e) {
      console.error(e);
      els.loading.classList.add('hidden');
      els.error.classList.remove('hidden');
    }
  })();

  function render(data) {
    var c = data.current_condition && data.current_condition[0];
    if (!c) throw new Error('No data');
    els.temp.textContent = (c.temp_C || '--') + '°C';
    els.desc.textContent = emoji(c.weatherCode) + ' ' + ((c.weatherDesc && c.weatherDesc[0] && c.weatherDesc[0].value) || '--');
    els.humidity.textContent = '💧 ' + (c.humidity || '--') + '%';
    els.wind.textContent = '💨 ' + (c.windSpeedKmph || '--') + ' km/h';

    if (data.weather) {
      els.forecast.innerHTML = '';
      data.weather.slice(0,3).forEach(function(d) {
        var e = document.createElement('div');
        e.className = 'flex items-center justify-between text-gray-600 dark:text-gray-300';
        e.innerHTML = '<span>' + fmtDate(d.date) + '</span><span>' + emoji(d.hourly?.[4]?.weatherCode) + '</span><span class="tabular-nums">' + (d.tempMinC ?? '--') + '° / ' + (d.tempMaxC ?? '--') + '°C</span>';
        els.forecast.appendChild(e);
      });
    }
    els.loading.classList.add('hidden');
    els.content.classList.remove('hidden');
  }
})();
</script>
