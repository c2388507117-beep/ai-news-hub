---

---

<div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 overflow-hidden shadow-sm">
  <!-- Header -->
  <button
    id="cover-toggle"
    class="w-full bg-gradient-to-r from-sky-500 to-blue-600 px-4 py-3 flex items-center justify-between cursor-pointer hover:from-sky-400 hover:to-blue-500 transition-all text-left"
    aria-expanded="false"
    aria-controls="cover-body"
  >
    <div class="flex items-center gap-2 min-w-0">
      <span class="text-xl leading-none flex-shrink-0">🎨</span>
      <h2 class="text-sm font-bold text-white truncate">封面搜索</h2>
    </div>
    <span id="cover-chevron" class="text-white/80 text-lg transition-transform duration-200 flex-shrink-0">▶</span>
  </button>

  <!-- Body -->
  <div id="cover-body" class="hidden">
    <div class="p-4">
      <!-- Search form -->
      <div class="flex gap-2 mb-3">
        <input
          type="text"
          id="cover-query"
          placeholder="输入关键词搜索封面..."
          class="flex-1 text-sm px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-1 focus:ring-sky-500 placeholder-gray-400 dark:placeholder-gray-500"
        />
        <select
          id="cover-type"
          class="text-sm px-2 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-1 focus:ring-sky-500"
        >
          <option value="books">📚 书籍</option>
          <option value="movies">🎬 影视</option>
          <option value="all">🔀 全部</option>
        </select>
        <button
          id="cover-search-btn"
          class="px-4 py-2 rounded-lg bg-gradient-to-r from-sky-500 to-blue-600 text-white text-sm font-medium hover:from-sky-400 hover:to-blue-500 transition-colors disabled:opacity-50 disabled:cursor-not-allowed whitespace-nowrap"
        >
          搜索
        </button>
      </div>

      <!-- Status messages -->
      <div id="cover-status" class="text-center text-sm text-gray-400 py-8">
        🔍 输入关键词搜索封面
      </div>

      <div id="cover-loading" class="hidden text-center text-sm text-gray-400 py-8">
        ⏳ 搜索中...
      </div>

      <div id="cover-error" class="hidden text-center text-sm text-red-500 py-8"></div>

      <!-- Results grid -->
      <div id="cover-results" class="hidden grid grid-cols-3 sm:grid-cols-4 gap-2"></div>
    </div>
  </div>
</div>

<!-- Modal overlay -->
<div id="cover-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70">
  <div class="relative max-w-[90vw] max-h-[90vh]">
    <button
      id="cover-modal-close"
      class="absolute -top-3 -right-3 w-8 h-8 rounded-full bg-white dark:bg-gray-800 shadow-lg flex items-center justify-center text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white text-lg font-bold z-10 transition-colors"
      aria-label="关闭预览"
    >
      ✕
    </button>
    <img id="cover-modal-img" class="max-w-full max-h-[85vh] rounded-lg shadow-2xl" alt="封面预览" />
  </div>
</div>

<script>
  (() => {
    // --- Toggle ---
    const toggle = document.getElementById('cover-toggle');
    const body = document.getElementById('cover-body');
    const chevron = document.getElementById('cover-chevron');
    if (toggle && body && chevron) {
      toggle.addEventListener('click', () => {
        const isOpen = !body.classList.contains('hidden');
        body.classList.toggle('hidden');
        chevron.style.transform = isOpen ? '' : 'rotate(90deg)';
        toggle.setAttribute('aria-expanded', String(!isOpen));
      });
    }

    // --- DOM refs ---
    const queryInput = document.getElementById('cover-query');
    const typeSelect = document.getElementById('cover-type');
    const searchBtn = document.getElementById('cover-search-btn');
    const statusEl = document.getElementById('cover-status');
    const loadingEl = document.getElementById('cover-loading');
    const resultsEl = document.getElementById('cover-results');
    const errorEl = document.getElementById('cover-error');
    const modal = document.getElementById('cover-modal');
    const modalImg = document.getElementById('cover-modal-img');
    const modalClose = document.getElementById('cover-modal-close');

    // --- Modal ---
    function openModal(src) {
      modalImg.src = src;
      modal.classList.remove('hidden');
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.style.display = '';
      modalImg.src = '';
      document.body.style.overflow = '';
    }

    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    modalClose.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    // --- API helper with CORS proxy fallback ---
    async function fetchJSON(url) {
      try {
        const res = await fetch(url);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        return await res.json();
      } catch (_directErr) {
        // Fallback: try CORS proxy
        const proxyUrl = `https://api.allorigins.win/raw?url=${encodeURIComponent(url)}`;
        const res = await fetch(proxyUrl);
        if (!res.ok) throw new Error(`Proxy HTTP ${res.status}`);
        return await res.json();
      }
    }

    // --- Search ---
    async function search() {
      const query = queryInput.value.trim();
      if (!query) {
        queryInput.focus();
        return;
      }

      // Reset state
      statusEl.classList.add('hidden');
      errorEl.classList.add('hidden');
      resultsEl.classList.add('hidden');
      resultsEl.innerHTML = '';
      loadingEl.classList.remove('hidden');
      searchBtn.disabled = true;

      const type = typeSelect.value;
      let allResults = [];

      try {
        // OpenLibrary (books)
        if (type === 'books' || type === 'all') {
          try {
            const booksUrl = `https://openlibrary.org/search.json?q=${encodeURIComponent(query)}`;
            const data = await fetchJSON(booksUrl);
            const docs = (data.docs || []).filter((d) => d.cover_i);
            allResults.push(
              ...docs.map((d) => ({
                source: 'book',
                title: d.title || '未知标题',
                subtitle: d.author_name ? d.author_name.join(', ') : '',
                thumbnailUrl: `https://covers.openlibrary.org/b/id/${d.cover_i}-M.jpg`,
                fullUrl: `https://covers.openlibrary.org/b/id/${d.cover_i}-L.jpg`,
              }))
            );
          } catch (err) {
            console.error('OpenLibrary error:', err);
          }
        }

        // iTunes Search
        if (type === 'movies' || type === 'all') {
          try {
            const itunesUrl = `https://itunes.apple.com/search?term=${encodeURIComponent(query)}&media=all&limit=15`;
            const data = await fetchJSON(itunesUrl);
            const items = data.results || [];

            let filtered = items;
            if (type === 'movies') {
              // Filter to movies / TV only
              filtered = items.filter(
                (r) =>
                  r.kind === 'feature-movie' ||
                  r.kind === 'tv-episode' ||
                  r.kind === 'tv-show'
              );
            }

            allResults.push(
              ...filtered.map((r) => ({
                source: 'itunes',
                title: r.trackName || r.collectionName || '未知标题',
                subtitle: r.artistName || '',
                thumbnailUrl: r.artworkUrl100 || '',
                fullUrl: (r.artworkUrl100 || '').replace('100x100', '600x600'),
              }))
            );
          } catch (err) {
            console.error('iTunes error:', err);
          }
        }

        loadingEl.classList.add('hidden');
        searchBtn.disabled = false;

        if (allResults.length === 0) {
          statusEl.textContent = '😕 未找到相关封面';
          statusEl.classList.remove('hidden');
          return;
        }

        // Render results
        resultsEl.classList.remove('hidden');

        for (const item of allResults) {
          const col = document.createElement('div');
          col.className =
            'flex flex-col items-center gap-1 cursor-pointer group';

          const imgWrap = document.createElement('div');
          imgWrap.className =
            'w-full aspect-[2/3] rounded-lg overflow-hidden bg-gray-100 dark:bg-gray-800 shadow-sm group-hover:shadow-md transition-shadow';

          const img = document.createElement('img');
          img.src = item.thumbnailUrl;
          img.alt = item.title;
          img.className =
            'w-full h-full object-cover group-hover:scale-105 transition-transform';
          img.loading = 'lazy';
          img.addEventListener('click', () => openModal(item.fullUrl));
          img.addEventListener('error', () => {
            // Show a placeholder on load failure
            img.style.display = 'none';
          });

          imgWrap.appendChild(img);
          col.appendChild(imgWrap);

          const label = document.createElement('span');
          label.className =
            'text-[10px] text-gray-500 dark:text-gray-400 text-center leading-tight line-clamp-2 w-full px-0.5';
          label.textContent = item.title;
          col.appendChild(label);

          resultsEl.appendChild(col);
        }
      } catch (err) {
        loadingEl.classList.add('hidden');
        searchBtn.disabled = false;
        errorEl.textContent = '❌ 搜索失败，请稍后重试';
        errorEl.classList.remove('hidden');
        console.error('Search error:', err);
      }
    }

    // --- Event listeners ---
    searchBtn.addEventListener('click', search);
    queryInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') search();
    });
  })();
</script>
