---
// AIEventCalendar — AI 产品发布日历
// Displays a timeline of notable AI product releases and events

export interface AIEvent {
  date: string;
  title: string;
  desc: string;
  url?: string;
  tag: string;
}

export interface Props {
  events: AIEvent[];
}

const { events } = Astro.props;
const sorted = (events || []).sort((a, b) => b.date.localeCompare(a.date));

const TAG_COLORS: Record<string, string> = {
  产品: 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300',
  开源: 'bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300',
  发布: 'bg-purple-100 text-purple-700 dark:bg-purple-900/40 dark:text-purple-300',
};

function fmtMD(dateStr: string): string {
  const d = new Date(dateStr + 'T00:00:00');
  return (d.getMonth() + 1) + '/' + d.getDate();
}
---

<div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 overflow-hidden shadow-sm">
  <div class="bg-gradient-to-r from-blue-600 to-violet-600 px-4 py-3">
    <h3 class="text-sm font-bold text-white flex items-center gap-2">
      <span aria-hidden="true">🗓️</span> AI 大事记
    </h3>
  </div>
  {sorted.length > 0 ? (
    <div class="relative pl-8 pr-4 py-3 space-y-3">
      <!-- Timeline line -->
      <div class="absolute left-[18px] top-0 bottom-0 w-0.5 bg-gray-200 dark:bg-gray-700"></div>
      {sorted.map((event) => (
        <div class="relative">
          <!-- Timeline dot -->
          <div class="absolute -left-[22px] top-1 w-3 h-3 rounded-full bg-blue-500 dark:bg-blue-400 border-2 border-white dark:border-gray-900"></div>
          {event.url ? (
            <a href={event.url} target="_blank" rel="noopener noreferrer" class="block hover:bg-gray-50 dark:hover:bg-gray-800/30 -mx-2 px-2 py-1 rounded-lg transition-colors">
              <div class="flex items-center gap-1.5">
                <span class="text-[10px] text-gray-400 tabular-nums">{fmtMD(event.date)}</span>
                <span class="text-[10px] px-1.5 py-0.5 rounded {TAG_COLORS[event.tag] || 'bg-gray-100 text-gray-600'}">{event.tag}</span>
              </div>
              <p class="text-xs font-semibold text-gray-800 dark:text-gray-200 mt-0.5">{event.title}</p>
              <p class="text-[11px] text-gray-500 dark:text-gray-400 line-clamp-1">{event.desc}</p>
            </a>
          ) : (
            <div>
              <div class="flex items-center gap-1.5">
                <span class="text-[10px] text-gray-400 tabular-nums">{fmtMD(event.date)}</span>
                <span class="text-[10px] px-1.5 py-0.5 rounded {TAG_COLORS[event.tag] || 'bg-gray-100 text-gray-600'}">{event.tag}</span>
              </div>
              <p class="text-xs font-semibold text-gray-800 dark:text-gray-200 mt-0.5">{event.title}</p>
              <p class="text-[11px] text-gray-500 dark:text-gray-400 line-clamp-1">{event.desc}</p>
            </div>
          )}
        </div>
      ))}
    </div>
  ) : (
    <p class="text-center text-gray-400 py-6 text-xs">暂无事件</p>
  )}
</div>
