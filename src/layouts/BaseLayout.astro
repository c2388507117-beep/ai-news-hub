---
export interface Props {
  title?: string;
  currentCategory?: string;
}

const { title = 'AI News Hub', currentCategory = '' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="AI News Hub - 每日 AI 新闻聚合" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="AI News Hub RSS" href="/rss.xml" />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" />
    <link rel="preconnect" href="https://{s}.tile.openstreetmap.org" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" id="theme-color" content="#2563eb" />
    <title>{title}</title>
    <!-- Dark mode init: prevent flash of wrong theme -->
    <script is:inline>
      (function() {
        var t = localStorage.getItem('theme');
        var dark = t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (dark) { document.documentElement.classList.add('dark'); }
        var tc = document.getElementById('theme-color');
        if (tc) { tc.content = dark ? '#030712' : '#2563eb'; }
      })();
    </script>
    <style>
      .safe-area-bottom {
        padding-bottom: env(safe-area-inset-bottom, 0px);
      }
    </style>
  </head>
  <body class="min-h-screen bg-gray-50 dark:bg-gray-950 text-gray-900 dark:text-gray-100
               font-sans antialiased pb-16 lg:pb-0">
    <header class="sticky top-0 z-10 bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm
                   border-b border-gray-200 dark:border-gray-800">
      <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="text-xl font-bold hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
          AI News Hub
        </a>
        <div class="flex items-center gap-3 text-sm text-gray-500 dark:text-gray-400">
          <a href="/tools" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">工具</a>
          <a href="/weekly" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">本周</a>
          <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">首页</a>
          <a href="/rss.xml" class="hover:text-orange-500 transition-colors">RSS</a>
          <button id="theme-toggle" class="p-1.5 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors" aria-label="切换深色模式">
            <!-- sun icon (shown in dark mode to switch to light) -->
            <svg class="hidden dark:block w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
            </svg>
            <!-- moon icon (shown in light mode to switch to dark) -->
            <svg class="block dark:hidden w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
            </svg>
          </button>
        </div>
      </div>
    </header>
    <slot />
    <slot name="footer" />

    <!-- Mobile Bottom Tab Navigation -->
    <nav class="fixed bottom-0 inset-x-0 z-20 lg:hidden
                bg-white/90 dark:bg-gray-900/90 backdrop-blur-lg
                border-t border-gray-200 dark:border-gray-800
                safe-area-bottom">
      <div class="flex items-center justify-around h-14">
        <a href="/" class="flex flex-col items-center gap-0.5 py-1 px-3 min-w-0 transition-colors {currentPath === '/' ? 'text-blue-600 dark:text-blue-400' : 'text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300'}">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          <span class="text-[10px] font-medium">首页</span>
        </a>
        <a href="/search" class="flex flex-col items-center gap-0.5 py-1 px-3 min-w-0 transition-colors {currentPath === '/search' ? 'text-blue-600 dark:text-blue-400' : 'text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300'}">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
          </svg>
          <span class="text-[10px] font-medium">搜索</span>
        </a>
        <a href="/tools" class="flex flex-col items-center gap-0.5 py-1 px-3 min-w-0 transition-colors {currentPath === '/tools' ? 'text-blue-600 dark:text-blue-400' : 'text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300'}">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/>
          </svg>
          <span class="text-[10px] font-medium">工具</span>
        </a>
        <a href="/weekly" class="flex flex-col items-center gap-0.5 py-1 px-3 min-w-0 transition-colors {currentPath === '/weekly' ? 'text-blue-600 dark:text-blue-400' : 'text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300'}">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          <span class="text-[10px] font-medium">本周</span>
        </a>
      </div>
    </nav>

    <script>
    // Shared expand/collapse for news cards
    document.addEventListener('click', (e) => {
      const card = e.target.closest('[data-expandable]');
      if (!card) return;
      if (e.target.closest('a')) return;

      const content = card.querySelector('.expanded-content');
      if (!content) return;

      content.classList.toggle('hidden');
      card.classList.toggle('expanded');
    });

    // Register Service Worker for PWA caching
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js', { scope: '/' });
    }

    // Dark mode toggle
    document.getElementById('theme-toggle').addEventListener('click', function() {
      var dark = document.documentElement.classList.contains('dark');
      var tc = document.getElementById('theme-color');
      if (dark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
        if (tc) tc.content = '#2563eb';
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
        if (tc) tc.content = '#030712';
      }
    });
    </script>
  </body>
</html>
